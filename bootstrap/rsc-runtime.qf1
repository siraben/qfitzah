    (PrimitiveEntry PrVecLen)
    (MovRM EAX EAX)
    (SubI8 EAX 02)
    (MovRMD EAX EAX 04)
    (Ret)
    (PrimitiveEntry PrVecQ)
    (MovRM EAX EAX)
    (MovRR ECX EAX)
    (AndI8 ECX 03)
    (CmpI8 ECX 02)
    (Jnz (VQ F))
    (SubI8 EAX 02)
    (MovRM EAX EAX)
    (AndI8 EAX 07)
    (CmpI8 EAX 04)
    (Jz (VQ T))
    (JmpS (VQ F))
    (ReturnBoolean VQ)
    (PrimitiveEntry PrVecList)
    (MovRM EAX EAX)
    (SubI8 EAX 02)
