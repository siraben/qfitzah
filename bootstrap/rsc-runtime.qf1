; rsc-runtime: fixed assembly runtime for Stage 4 (rsc.scm).
; Load qfasm.qf1 and runtime-support.qf1 first.
; Primitive initialization/storage are seed-expanded descriptor folds.
; EBP=environment frames; EAX=argument list; EDI=captured environment.
; A callable is subtype 2, with (code . env) payload. Vectors are subtype 4,
; pointing to a buffer of four-byte values with a fixnum element count.
; See ARCHITECTURE.md for the runtime layout.
; Provides (RuntimeCode rest)/(RuntimeData rest), consumed by compiled output.
; DObj/MovRIObj descriptors (address + 2) live in runtime-support.qf1.

; Also used by sc1's output when it builds the first native rsc compiler.
(RuntimeMemoryBytes) (GcMemoryBytes)

(Rule (RuntimeCode rest)
  (Block (
    (Splice (GcCode))
    (Splice (IoCode))
    (Splice (ControlCode))
    (Label InitPrims)
    (ForPrimitives Compiled (RscPrimitives))
    (Ret)
    ; Cons(EAX, ECX) returns a pair, preserving ECX and EDX.
    (Label Cons)
    (PushR EDI)
    (PushR ECX)
    (MovRI ECX (Small 8))
    (Call AllocBytes)
    (PopR ECX)
    (MovMR EDI EAX)
    (MovMDR EDI 04 ECX)
    (MovRR EAX EDI)
    (PopR EDI)
    (Ret)
    ; AllocObj copies symbol/string bytes; its object header is a traced Cons.
    (Label AllocObj)
    (PushR EDX)
    (Call AllocAtomic)
    (PushR EDI)
    (MovRR ESI EAX)
    (PushR ECX)
    (RepMovsb)
    (PopR ECX)
    (PopR EAX)
    (PopR EDX)
    (OrRR EAX EDX)
    (PushR EAX)
    (MovRR EAX ECX)
    (ShlI8 EAX 02)
    (OrI8 EAX 01)
    (MovRR ECX EAX)
    (PopR EAX)
    (Call Cons)
    (OrI8 EAX 02)
    (Ret)
    (Label ReadCh)
    (MovRMemL EAX GPeek)
    (CmpEaxI32 (X8 F F F F F F F F))
    (Jz (RC 1))
    (PushR ECX)
    (MovRI ECX (X8 F F F F F F F F))
    (MovMemLR GPeek ECX)
    (PopR ECX)
    (Ret)
    (Label (RC 1))
    (PushR ECX)
    (MovRMemL EAX GInPtr)
    (MovRMemL ECX GInEnd)
    (CmpRR EAX ECX)
    (Jnz (RC 3))
    (PushR EBX)
    (PushR EDX)
    (MovRI EAX (Small 3))
    (XorRR EBX EBX)
    (MovRMemL ECX GReadBuf)
    (MovRI EDX (X8 0 0 4 0 0 0 0 0))
    (Int 80)
    (TestRR EAX EAX)
    (Jg (RC 2))
    (PopR EDX)
    (PopR EBX)
    (PopR ECX)
    (MovRI EAX (X8 F F F F F F F F))
    (Ret)
    (Label (RC 2))
    (MovRMemL ECX GReadBuf)
    (MovMemLR GInPtr ECX)
    (AddRR ECX EAX)
    (MovMemLR GInEnd ECX)
    (PopR EDX)
    (PopR EBX)
    (MovRMemL EAX GInPtr)
    (Label (RC 3))
    (MovRR ECX EAX)
    (MovzxRMb EAX ECX)
    (IncR ECX)
    (MovMemLR GInPtr ECX)
    (PopR ECX)
    (Ret)
    (Label PeekCh)
    (Call ReadCh)
    (MovMemLR GPeek EAX)
    (Ret)
    (Label Emit)
    (PushR EBX)
    (PushR ECX)
    (PushR EDX)
    (MovRILabel ECX WriteChBuf)
    (MovbMR ECX EAX)
    (MovRI EAX (Small 4))
    (MovRI EBX (Small 1))
    (MovRI EDX (Small 1))
    (Int 80)
    (PopR EDX)
    (PopR ECX)
    (PopR EBX)
    (Ret)
    (Label PrintRaw)
    (MovRI EAX (Small 4))
    (MovRI EBX (Small 1))
    (Int 80)
    (Ret)
    (Label ErrApply)
    (MovRI EAX (X8 0 0 0 0 0 0 2 1))
    (Call Emit)
    (MovRI EAX (Small A))
    (Call Emit)
    (MovRI EAX (Small 1))
    (MovRI EBX (Small 1))
    (Int 80)
    (Label Intern)
    (MovRMemL EDX GObList)
    (Label (IN 1))
    (TestRI8 EDX 03)
    (Jz (IN 2))
    (XorRR EDX EDX)
    (Call AllocObj)
    (PushR EAX)
    (MovRMemL ECX GObList)
    (Call Cons)
    (MovMemLR GObList EAX)
    (PopR EAX)
    (Ret)
    (Label (IN 2))
    (MovRM EBX EDX)
    (MovRR EDI EBX)
    (SubI8 EDI 02)
    (MovRMD ESI EDI 04)
    (SarI8 ESI 02)
    (CmpRR ESI ECX)
    (Jnz (IN 3))
    (MovRM ESI EDI)
    (MovRR EDI EAX)
    (PushR ECX)
    (RepeCmpsb)
    (PopR ECX)
    (Jnz (IN 3))
    (MovRR EAX EBX)
    (Ret)
    (Label (IN 3))
    (MovRMD EDX EDX 04)
    (JmpS (IN 1))
    (PrimitiveEntry PrCons)
    (MovRMD ECX EAX 04)
    (MovRM ECX ECX)
    (MovRM EAX EAX)
    (Jmp32 Cons)
    (PrimitiveEntry PrCar)
    (MovRM EAX EAX)
    (TestRI8 EAX 03)
    (Jz (CAR 1))
    (Jmp32 ErrApply)
    (Label (CAR 1))
    (MovRM EAX EAX)
    (Ret)
    (PrimitiveEntry PrCdr)
    (MovRM EAX EAX)
    (TestRI8 EAX 03)
    (Jz (CDR 1))
    (Jmp32 ErrApply)
    (Label (CDR 1))
    (MovRMD EAX EAX 04)
    (Ret)
    (PrimitiveEntry PrSetCar)
    (MovRM ECX EAX)
    (MovRMD EAX EAX 04)
    (MovRM EAX EAX)
    (MovMR ECX EAX)
    (MovRI EAX (X8 0 0 0 0 0 0 4 3))
    (Ret)
    (PrimitiveEntry PrSetCdr)
    (MovRM ECX EAX)
    (MovRMD EAX EAX 04)
    (MovRM EAX EAX)
    (MovMDR ECX 04 EAX)
    (MovRI EAX (X8 0 0 0 0 0 0 4 3))
    (Ret)
    (PrimitiveEntry PrPairQ)
    (MovRM EAX EAX)
    (TestRI8 EAX 03)
    (Jz (PQ T))
    (JmpS (PQ F))
    (ReturnBoolean PQ)
    (PrimitiveEntry PrNullQ)
    (MovRM EAX EAX)
    (CmpEaxI32 (Small 3))
    (Jz (NQ T))
    (JmpS (NQ F))
    (ReturnBoolean NQ)
    (PrimitiveEntry PrEqQ)
    (MovRM ECX EAX)
    (MovRMD EAX EAX 04)
    (MovRM EAX EAX)
    (CmpRR EAX ECX)
    (Jz (EQ T))
    (JmpS (EQ F))
    (ReturnBoolean EQ)
    (PrimitiveEntry PrSymQ)
    (MovRM EAX EAX)
    (MovRR ECX EAX)
    (AndI8 ECX 03)
    (CmpI8 ECX 02)
    (Jnz (SYQ F))
    (SubI8 EAX 02)
    (MovRM EAX EAX)
    (TestRI8 EAX 07)
    (Jz (SYQ T))
    (JmpS (SYQ F))
    (ReturnBoolean SYQ)
    (PrimitiveEntry PrNumQ)
    (MovRM EAX EAX)
    (TestRI8 EAX 01)
    (Jz (NUQ F))
    (TestRI8 EAX 02)
    (Jz (NUQ T))
    (JmpS (NUQ F))
    (ReturnBoolean NUQ)
    (PrimitiveEntry PrStrQ)
    (MovRM EAX EAX)
    (MovRR ECX EAX)
    (AndI8 ECX 03)
    (CmpI8 ECX 02)
    (Jnz (STQ F))
    (SubI8 EAX 02)
    (MovRM EAX EAX)
    (AndI8 EAX 07)
    (CmpI8 EAX 01)
    (Jz (STQ T))
    (JmpS (STQ F))
    (ReturnBoolean STQ)
    (PrimitiveEntry PrCharQ)
    (MovRM EAX EAX)
    (AndI32 EAX (X8 0 0 0 0 0 0 F F))
    (CmpI8 EAX 53)
    (Jz (CHQ T))
    (JmpS (CHQ F))
    (ReturnBoolean CHQ)
    (PrimitiveEntry PrProcQ)
    (MovRM EAX EAX)
    (MovRR ECX EAX)
    (AndI8 ECX 03)
    (CmpI8 ECX 02)
    (Jnz (PCQ F))
    (SubI8 EAX 02)
    (MovRM EAX EAX)
    (AndI8 EAX 07)
    (CmpI8 EAX 02)
    (Jz (PCQ T))
    (CmpI8 EAX 03)
    (Jz (PCQ T))
    (JmpS (PCQ F))
    (ReturnBoolean PCQ)
    (PrimitiveEntry PrBoolQ)
    (MovRM EAX EAX)
    (CmpEaxI32 (X8 0 0 0 0 0 0 1 3))
    (Jz (BQ T))
    (CmpEaxI32 (X8 0 0 0 0 0 0 2 3))
    (Jz (BQ T))
    (JmpS (BQ F))
    (ReturnBoolean BQ)
    (PrimitiveEntry PrNot)
    (MovRM EAX EAX)
    (CmpEaxI32 (X8 0 0 0 0 0 0 2 3))
    (Jz (NO T))
    (JmpS (NO F))
    (ReturnBoolean NO)
    (PrimitiveEntry PrAdd)
    (MovRI ECX (Small 1))
    (Label (AD 1))
    (TestRI8 EAX 03)
    (Jnz (AD 2))
    (MovRM EDX EAX)
    (AddRR ECX EDX)
    (DecR ECX)
    (MovRMD EAX EAX 04)
    (JmpS (AD 1))
    (Label (AD 2))
    (MovRR EAX ECX)
    (Ret)
    (PrimitiveEntry PrSub)
    (MovRM ECX EAX)
    (MovRMD EAX EAX 04)
    (TestRI8 EAX 03)
    (Jz (SB 1))
    (MovRI EAX (Small 2))
    (SubRR EAX ECX)
    (Ret)
    (Label (SB 1))
    (MovRM EDX EAX)
    (SubRR ECX EDX)
    (IncR ECX)
    (MovRMD EAX EAX 04)
    (TestRI8 EAX 03)
    (Jz (SB 1))
    (MovRR EAX ECX)
    (Ret)
    (PrimitiveEntry PrMul)
    (MovRI ECX (Small 1))
    (Label (MU 1))
    (TestRI8 EAX 03)
    (Jnz (MU 2))
    (MovRM EDX EAX)
    (SarI8 EDX 02)
    (IMulRR ECX EDX)
    (MovRMD EAX EAX 04)
    (JmpS (MU 1))
    (Label (MU 2))
    (MovRR EAX ECX)
    (ShlI8 EAX 02)
    (OrI8 EAX 01)
    (Ret)
    (PrimitiveEntry PrQuot)
    (MovRM ECX EAX)
    (MovRMD EAX EAX 04)
    (MovRM EBX EAX)
    (MovRR EAX ECX)
    (SarI8 EAX 02)
    (SarI8 EBX 02)
    (Cdq)
    (IDivR EBX)
    (ShlI8 EAX 02)
    (OrI8 EAX 01)
    (Ret)
    (PrimitiveEntry PrRem)
    (MovRM ECX EAX)
    (MovRMD EAX EAX 04)
    (MovRM EBX EAX)
    (MovRR EAX ECX)
    (SarI8 EAX 02)
    (SarI8 EBX 02)
    (Cdq)
    (IDivR EBX)
    (MovRR EAX EDX)
    (ShlI8 EAX 02)
    (OrI8 EAX 01)
    (Ret)
    (ComparePrimitive PrNumEq NE Jz)
    (ComparePrimitive PrLt LTP Jl)
    (ComparePrimitive PrGt GTP Jg)
    (ComparePrimitive PrLe LEP Jle)
    (ComparePrimitive PrGe GEP Jge)
    (PrimitiveEntry PrDisplay)
    (MovRM EAX EAX)
    (MovRR ECX EAX)
    (AndI8 ECX 03)
    (CmpI8 ECX 02)
    (Jnz (DS 2))
    (MovRR EDX EAX)
    (SubI8 EDX 02)
    (MovRM ECX EDX)
    (MovRR EBX ECX)
    (AndI8 EBX 07)
    (CmpI8 EBX 01)
    (Jnz (DS 3))
    (AndI8 ECX F8)
    (MovRMD EDX EDX 04)
    (SarI8 EDX 02)
    (Call PrintRaw)
    (MovRI EAX (X8 0 0 0 0 0 0 4 3))
    (Ret)
    (Label (DS 2))
    (CmpI8 ECX 03)
    (Jnz (DS 3))
    (MovRR EDX EAX)
    (AndI32 EDX (X8 0 0 0 0 0 0 F F))
    (CmpI8 EDX 53)
    (Jnz (DS 3))
    (ShrI8 EAX 08)
    (Call Emit)
    (MovRI EAX (X8 0 0 0 0 0 0 4 3))
    (Ret)
    (Label (DS 3))
    (Call Print)
    (MovRI EAX (X8 0 0 0 0 0 0 4 3))
    (Ret)
    (PrimitiveEntry PrWrite)
    (MovRM EAX EAX)
    (Call Print)
    (MovRI EAX (X8 0 0 0 0 0 0 4 3))
    (Ret)
    (PrimitiveEntry PrNewline)
    (MovRI EAX (Small A))
    (Call Emit)
    (MovRI EAX (X8 0 0 0 0 0 0 4 3))
    (Ret)
    (PrimitiveEntry PrReadChar)
    (Call ReadCh)
    (CmpEaxI32 (X8 F F F F F F F F))
    (Jz (RDC 1))
    (ShlI8 EAX 08)
    (OrI8 EAX 53)
    (Ret)
    (Label (RDC 1))
    (MovRI EAX (X8 0 0 0 0 0 0 3 3))
    (Ret)
    (PrimitiveEntry PrPeekChar)
    (Call PeekCh)
    (CmpEaxI32 (X8 F F F F F F F F))
    (Jz (PKC 1))
    (ShlI8 EAX 08)
    (OrI8 EAX 53)
    (Ret)
    (Label (PKC 1))
    (MovRI EAX (X8 0 0 0 0 0 0 3 3))
    (Ret)
    (PrimitiveEntry PrEofQ)
    (MovRM EAX EAX)
    (CmpEaxI32 (X8 0 0 0 0 0 0 3 3))
    (Jz (EFQ T))
    (JmpS (EFQ F))
    (ReturnBoolean EFQ)
    (PrimitiveEntry PrCharInt)
    (MovRM EAX EAX)
    (ShrI8 EAX 08)
    (ShlI8 EAX 02)
    (OrI8 EAX 01)
    (Ret)
    (PrimitiveEntry PrIntChar)
    (MovRM EAX EAX)
    (SarI8 EAX 02)
    (ShlI8 EAX 08)
    (OrI8 EAX 53)
    (Ret)
    (PrimitiveEntry PrStrLen)
    (MovRM EAX EAX)
    (SubI8 EAX 02)
    (MovRMD EAX EAX 04)
    (Ret)
    (PrimitiveEntry PrStrRef)
    (MovRM ECX EAX)
    (MovRMD EAX EAX 04)
    (MovRM EDX EAX)
    (SubI8 ECX 02)
    (MovRM EBX ECX)
    (AndI8 EBX F8)
    (SarI8 EDX 02)
    (AddRR EBX EDX)
    (MovzxRMb EAX EBX)
    (ShlI8 EAX 08)
    (OrI8 EAX 53)
    (Ret)
    (PrimitiveEntry PrStrSym)
    (MovRM EAX EAX)
    (SubI8 EAX 02)
    (MovRR EDX EAX)
    (MovRM EAX EDX)
    (AndI8 EAX F8)
    (MovRMD ECX EDX 04)
    (SarI8 ECX 02)
    (Jmp32 Intern)
    (PrimitiveEntry PrSymStr)
    (MovRM EAX EAX)
    (SubI8 EAX 02)
    (MovRM EDX EAX)
    (OrI8 EDX 01)
    (MovRMD ECX EAX 04)
    (MovRR EAX EDX)
    (Call Cons)
    (OrI8 EAX 02)
    (Ret)
    (PrimitiveEntry PrListStr)
    (MovRM EDX EAX)
    (MovRMemL EDI GTokBuf)
    (MovRR ECX EDI)
    (AddI32 ECX (X8 0 0 4 0 0 0 0 0))
    (Label (LS 1))
    (TestRI8 EDX 03)
    (Jnz (LS 2))
    (CmpRR EDI ECX)
    (Jae32 GcOutOfMemory)
    (MovRM EAX EDX)
    (ShrI8 EAX 08)
    (MovbMR EDI EAX)
    (IncR EDI)
    (MovRMD EDX EDX 04)
    (JmpS (LS 1))
    (Label (LS 2))
    (MovRMemL EAX GTokBuf)
    (MovRR ECX EDI)
    (SubRR ECX EAX)
    (MovRI EDX (Small 1))
    (Jmp32 AllocObj)
    (PrimitiveEntry PrMakeStr)
    (MovRM ECX EAX)
    (SarI8 ECX 02)
    (MovRMD EDX EAX 04)
    (TestRI8 EDX 03)
    (Jz (MS 0))
    (MovRI EBX (X8 0 0 0 0 0 0 2 0))
    (JmpS (MS 1))
    (Label (MS 0))
    (MovRM EBX EDX)
    (ShrI8 EBX 08)
    (Label (MS 1))
    (Call AllocAtomic)
    (PushR EDI)
    (PushR ECX)
    (Label (MS 2))
    (TestRR ECX ECX)
    (Jz (MS 3))
    (MovbMR EDI EBX)
    (IncR EDI)
    (DecR ECX)
    (JmpS (MS 2))
    (Label (MS 3))
    (PopR ECX)
    (PopR EAX)
    (OrI8 EAX 01)
    (PushR EAX)
    (MovRR EAX ECX)
    (ShlI8 EAX 02)
    (OrI8 EAX 01)
    (MovRR ECX EAX)
    (PopR EAX)
    (Call Cons)
    (OrI8 EAX 02)
    (Ret)
    (PrimitiveEntry PrStrSet)
    (MovRM ECX EAX)
    (MovRMD EAX EAX 04)
    (MovRM EDX EAX)
    (SarI8 EDX 02)
    (MovRMD EAX EAX 04)
    (MovRM EAX EAX)
    (ShrI8 EAX 08)
    (SubI8 ECX 02)
    (MovRM ECX ECX)
    (AndI8 ECX F8)
    (AddRR ECX EDX)
    (MovbMR ECX EAX)
    (MovRI EAX (X8 0 0 0 0 0 0 4 3))
    (Ret)
    ; Copy the final apply list: procedure frames are mutable binding cells.
    ; Iterative, preserving EBX (the procedure), with fresh head/tail in
    ; EDI/ESI and remaining source in EDX. Never mutate caller-owned pairs.
    (Label CopyArgs)
    (MovRR EDX EAX)
    (MovRI EDI (Small 3))
    (MovRI ESI (Small 3))
    (Label (CPA Next))
    (CmpI8 EDX 03)
    (Jz (CPA Done))
    (TestRI8 EDX 03)
    (Jnz32 ErrApply)
    (MovRM EAX EDX)
    (MovRI ECX (Small 3))
    (Call Cons)
    (CmpI8 EDI 03)
    (Jnz (CPA Link))
    (MovRR EDI EAX)
    (JmpS (CPA Tail))
    (Label (CPA Link))
    (MovMDR ESI 04 EAX)
    (Label (CPA Tail))
    (MovRR ESI EAX)
    (MovRMD EDX EDX 04)
    (JmpS (CPA Next))
    (Label (CPA Done))
    (MovRR EAX EDI)
    (Ret)
    (Label AppendArgs)
    (MovRMD ECX EAX 04)
    (TestRI8 ECX 03)
    (Jnz (APA 1))
    (PushR EAX)
    (MovRR EAX ECX)
    (Call AppendArgs)
    (PopR ECX)
    (MovRR EDX EAX)
    (MovRM EAX ECX)
    (MovRR ECX EDX)
    (Jmp32 Cons)
    (Label (APA 1))
    (MovRM EAX EAX)
    (Jmp32 CopyArgs)
    (PrimitiveEntry PrApply)
    (MovRM EBX EAX)
    (MovRMD EAX EAX 04)
    (TestRI8 EAX 03)
    (Jz (APL 1))
    (MovRI EAX (Small 3))
    (JmpS (APL 2))
    (Label (APL 1))
    (Call AppendArgs)
    (Label (APL 2))
    (MovRR ESI EBX)
    (SubI8 ESI 02)
    (MovRM ESI ESI)
    (AndI8 ESI F8)
    (MovRMD EDI ESI 04)
    (MovRM ESI ESI)
    (JmpR ESI)
    (PrimitiveEntry PrMakeVec)
    (MovRM ECX EAX)
    (SarI8 ECX 02)
    (MovRMD EDX EAX 04)
    (TestRI8 EDX 03)
    (Jz (MV 0))
    (MovRI EBX (X8 0 0 0 0 0 0 2 3))
    (JmpS (MV 1))
    (Label (MV 0))
    (MovRM EBX EDX)
    (Label (MV 1))
    (Call AllocVectorBytes)
    (PushR EDI)
    (PushR ECX)
    (Label (MV 2))
    (TestRR ECX ECX)
    (Jz (MV 3))
    (MovMR EDI EBX)
    (AddI8 EDI 04)
    (DecR ECX)
    (JmpS (MV 2))
    (Label (MV 3))
    (PopR ECX)
    (PopR EAX)
    (OrI8 EAX 04)
    (PushR EAX)
    (MovRR EAX ECX)
    (ShlI8 EAX 02)
    (OrI8 EAX 01)
    (MovRR ECX EAX)
    (PopR EAX)
    (Call Cons)
    (OrI8 EAX 02)
    (Ret)
    ; Bound before multiplying: negative sizes and overflow cannot wrap.
    (Label AllocVectorBytes)
    (CmpI32 ECX (X8 0 2 0 0 0 0 0 0))
    (Jae32 GcOutOfMemory)
    (PushR ECX)
    (ShlI8 ECX 02)
    (Call AllocBytes)
    (PopR ECX)
    (Ret)
    (PrimitiveEntry PrVector)
    (MovRR EDX EAX)
    (Jmp32 VecFromList)
    (PrimitiveEntry PrListVec)
    (MovRM EDX EAX)
    (Jmp32 VecFromList)
    (Label VecFromList)
    (XorRR ECX ECX)
    (MovRR EBX EDX)
    (Label (LV 1))
    (TestRI8 EBX 03)
    (Jnz (LV 2))
    (IncR ECX)
    (MovRMD EBX EBX 04)
    (JmpS (LV 1))
    (Label (LV 2))
    (Call AllocVectorBytes)
    (PushR EDI)
    (PushR ECX)
    (MovRR EBX EDX)
    (Label (LV 3))
    (TestRI8 EBX 03)
    (Jnz (LV 4))
    (MovRM EAX EBX)
    (MovMR EDI EAX)
    (AddI8 EDI 04)
    (MovRMD EBX EBX 04)
    (JmpS (LV 3))
    (Label (LV 4))
    (PopR ECX)
    (PopR EAX)
    (OrI8 EAX 04)
    (PushR EAX)
    (MovRR EAX ECX)
    (ShlI8 EAX 02)
    (OrI8 EAX 01)
    (MovRR ECX EAX)
    (PopR EAX)
    (Call Cons)
    (OrI8 EAX 02)
    (Ret)
    (PrimitiveEntry PrVecRef)
    (MovRM ECX EAX)
    (MovRMD EAX EAX 04)
    (MovRM EAX EAX)
    (AndI8 EAX FC)
    (SubI8 ECX 02)
    (MovRM ECX ECX)
    (AndI8 ECX F8)
    (AddRR ECX EAX)
    (MovRM EAX ECX)
    (Ret)
    (PrimitiveEntry PrVecSet)
    (MovRM ECX EAX)
    (MovRMD EAX EAX 04)
    (MovRM EDX EAX)
    (AndI8 EDX FC)
    (MovRMD EAX EAX 04)
    (MovRM EAX EAX)
    (SubI8 ECX 02)
    (MovRM ECX ECX)
    (AndI8 ECX F8)
    (AddRR ECX EDX)
    (MovMR ECX EAX)
    (MovRI EAX (X8 0 0 0 0 0 0 4 3))
