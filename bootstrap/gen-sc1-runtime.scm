; ---------------------------------------------------------------------------
; DATA
; ---------------------------------------------------------------------------
(define (build-data)
  (set-cur! 'd)
  (I "(Align4)")
  (for-each
    (lambda (g)
      (begin
        (L g)
        (I (string-append "(Dd "
             (x8-str (if (string=? g "GObList") (k NIL) (k 0))) ")"))))
    (list "GCellFree" "GByteFree" "GInPtr" "GInEnd" "GObList"
          "GTokBuf" "GReadBuf"))
  (L "GPeek")
  (I (string-append "(Dd " (x8-str wm1) ")"))
  (L "WriteChBuf")
  (I "(Db 00)")
  (I "(Align4)")
  (for-each
    (lambda (p)
      (begin
        (L (gv (car p)))
        (I (string-append "(Dd " (x8-str (k 0)) ")"))))
    PRIMS)
  (I "(Align8)")
  (L "CodeEnd"))

; ---------------------------------------------------------------------------
; Emission.
; ---------------------------------------------------------------------------
(define (repeat-str s n) (if (= n 0) "" (string-append s (repeat-str s (- n 1)))))
(define (take-n lst n) (if (or (= n 0) (null? lst)) '() (cons (car lst) (take-n (cdr lst) (- n 1)))))
(define (drop-n lst n) (if (or (= n 0) (null? lst)) lst (drop-n (cdr lst) (- n 1))))
(define (pl s) (begin (display s) (newline)))

(define (emit-blocks top chain items bi)
  (if (null? items)
      #t
      (let ((blk (take-n items 24))
            (rest (drop-n items 24)))
        (begin
          (if (= bi 0)
              (pl (string-append "(Rule (" top " rest)"))
              (pl (string-append "(Rule (" chain " " (number->string bi) " rest)")))
          (for-each (lambda (ins) (pl (string-append "  (Ins " ins))) blk)
          (if (null? rest)
              (pl (string-append "  rest" (repeat-str ")" (length blk)) ")"))
              (pl (string-append "  (" chain " " (number->string (+ bi 1)) " rest)"
                    (repeat-str ")" (length blk)) ")")))
          (emit-blocks top chain rest (+ bi 1))))))

(define (emit-macro top chain items) (emit-blocks top chain items 0))

(define (emit-flat cc dd)
  (begin
    (for-each pl cc)
    (pl "RTSPLIT")
    (for-each pl dd)))

(define (has-flat)
  (let ((a (command-line)))
    (and (pair? a) (pair? (cdr a)) (string=? (cadr a) "--flat"))))

(define (main)
  (begin
    (build-code)
    (build-data)
    (let ((cc (reverse c-rev)) (dd (reverse d-rev)))
      (if (has-flat)
          (emit-flat cc dd)
          (begin
            (pl "; sc1-runtime: fixed assembly runtime for Stage 3 (sc1.scm).")
            (pl "; GENERATED by tools/generate_sc1_runtime.py -- edit the builder.")
            (pl "; Provides (RuntimeCode rest)/(RuntimeData rest) macros plus the")
            (pl "; DObj/MovRIObj directives, all consumed by compiled sc1 output.")
            (pl "")
            (pl "; Extra directives: object-pointer constants (label address + 2).")
            (pl "(Size (DObj l)) (Small 4)")
            (pl "(Pass2 (Ins (DObj l) rest) pc sym) (Bytes (LEB (Add32 (VAddr (Lookup l sym)) (Small 2))) (Pass2 rest (Add32 pc (Small 4)) sym))")
            (pl "(Size (MovRIObj r l)) (Small 5)")
            (pl "(Pass2 (Ins (MovRIObj r l) rest) pc sym) (Bytes (MovIB r) (LEB (Add32 (VAddr (Lookup l sym)) (Small 2))) (Pass2 rest (Add32 pc (Small 5)) sym))")
            (pl "")
            (emit-macro "RuntimeCode" "RTC" cc)
            (pl "")
            (emit-macro "RuntimeData" "RTD" dd))))))

(main)
