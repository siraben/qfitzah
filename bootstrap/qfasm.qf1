; qfasm: i386 assembler in Qfitzah.
; All arithmetic, register encoding and instruction expansion run in Qfitzah.
; Values are little-endian nybbles (N d0 ... d7); O/I are binary zero/one.

; The hexadecimal alphabet, in least-significant-bit-first order.
(Digit 0) (Bits O O O O)
(Digit 1) (Bits I O O O)
(Digit 2) (Bits O I O O)
(Digit 3) (Bits I I O O)
(Digit 4) (Bits O O I O)
(Digit 5) (Bits I O I O)
(Digit 6) (Bits O I I O)
(Digit 7) (Bits I I I O)
(Digit 8) (Bits O O O I)
(Digit 9) (Bits I O O I)
(Digit A) (Bits O I O I)
(Digit B) (Bits I I O I)
(Digit C) (Bits O O I I)
(Digit D) (Bits I O I I)
(Digit E) (Bits O I I I)
(Digit F) (Bits I I I I)
(Nybble O O O O) 0
(Nybble I O O O) 1
(Nybble O I O O) 2
(Nybble I I O O) 3
(Nybble O O I O) 4
(Nybble I O I O) 5
(Nybble O I I O) 6
(Nybble I I I O) 7
(Nybble O O O I) 8
(Nybble I O O I) 9
(Nybble O I O I) A
(Nybble I I O I) B
(Nybble O O I I) C
(Nybble I O I I) D
(Nybble O I I I) E
(Nybble I I I I) F

; One-bit full adder: (FA carry a b) -> (Bit sum carry).
; Four applications add a nybble.
(FA O O O) (Bit O O)
(FA O O I) (Bit I O)
(FA O I O) (Bit I O)
(FA O I I) (Bit O I)
(FA I O O) (Bit I O)
(FA I O I) (Bit O I)
(FA I I O) (Bit O I)
(FA I I I) (Bit I I)
(AD c a b) (ADBits c (Digit a) (Digit b))
(ADBits c (Bits a0 a1 a2 a3) (Bits b0 b1 b2 b3)) (ADBit1 (FA c a0 b0) a1 b1 a2 b2 a3 b3)
(ADBit1 (Bit s0 c) a1 b1 a2 b2 a3 b3) (ADBit2 s0 (FA c a1 b1) a2 b2 a3 b3)
(ADBit2 s0 (Bit s1 c) a2 b2 a3 b3) (ADBit3 s0 s1 (FA c a2 b2) a3 b3)
(ADBit3 s0 s1 (Bit s2 c) a3 b3) (ADBit4 s0 s1 s2 (FA c a3 b3))
(ADBit4 s0 s1 s2 (Bit s3 c)) (P (Nybble s0 s1 s2 s3) c)
; PC increments have mostly zero high digits. Avoid needless bit expansion.
; These identities use the same hexadecimal-digit operand contract as AD.
(AD O a 0) (P a O)
(AD O 0 b) (P b O)
(NotBit O) I
(NotBit I) O
(ND d) (Complement (Digit d))
(Complement (Bits a b c d)) (Nybble (NotBit a) (NotBit b) (NotBit c) (NotBit d))
(HB hi lo) (Hex hi lo)

; Architectural register numbers.
(Reg EAX) (R O O O)
(Reg ECX) (R I O O)
(Reg EDX) (R O I O)
(Reg EBX) (R I I O)
(Reg ESP) (R O O I)
(Reg EBP) (R I O I)
(Reg ESI) (R O I I)
(Reg EDI) (R I I I)
; ModRM = mod:2 | reg:3 | rm:3. Bit arguments are low-first.
(ModRM m0 m1 (R a0 a1 a2) (R b0 b1 b2)) (Hex (Nybble a1 a2 m0 m1) (Nybble b0 b1 b2 a0))
(RM11 reg rm) (ModRM I I (Reg reg) (Reg rm))
(RM00 base reg) (ModRM O O (Reg reg) (Base0 base))
(RM01 base reg) (ModRM I O (Reg reg) (Base8 base))
(RM05 reg) (ModRM O O (Reg reg) (Reg EBP))
(RMX ext reg) (ModRM I I (Extension (Digit ext)) (Reg reg))
(Extension (Bits a b c O)) (R a b c)
; [ESP] requires SIB; [EBP] requires a displacement. Unsupported shapes stick
; and are rejected at the byte boundary, never silently given a wrong size.
(Base0 EAX) (Reg EAX)
(Base0 ECX) (Reg ECX)
(Base0 EDX) (Reg EDX)
(Base0 EBX) (Reg EBX)
(Base0 ESI) (Reg ESI)
(Base0 EDI) (Reg EDI)
(Base8 reg) (Base0 reg)
(Base8 EBP) (Reg EBP)
(RegByte hi top (R a b c)) (Hex hi (Nybble a b c top))
(IncB reg) (RegByte 4 O (Reg reg))
(DecB reg) (RegByte 4 I (Reg reg))
(PushB reg) (RegByte 5 O (Reg reg))
(PopB reg) (RegByte 5 I (Reg reg))
(MovIB reg) (RegByte B I (Reg reg))
(XchgAB reg) (RegByte 9 O (Reg reg))

; Alignment is (-low-digit) masked to the low two/three bits.
(NegDigit d) (SumDigit (AD I (ND d) 0))
(SumDigit (P d c)) d
(PadDig4 d) (Mask4 (Digit (NegDigit d)))
(PadDig8 d) (Mask8 (Digit (NegDigit d)))
(Mask4 (Bits a b c d)) (Nybble a b O O)
(Mask8 (Bits a b c d)) (Nybble a b c O)
(R8P d) (PositiveHi (Digit d))
(R8N d) (NegativeHi (Digit d))
(PositiveHi (Bits a b c O)) OK
(NegativeHi (Bits a b c I)) OK
(X8 a b c d e f g h) (N h g f e d c b a)
(Small d) (N d 0 0 0 0 0 0 0)

; 32-bit add (wraps mod 2^32): digit-chained through (AD ...).
(Add32 (N a0 a1 a2 a3 a4 a5 a6 a7) (N b0 b1 b2 b3 b4 b5 b6 b7)) (A1 (AD O a0 b0) a1 b1 a2 b2 a3 b3 a4 b4 a5 b5 a6 b6 a7 b7)
(A1 (P s0 c) a1 b1 a2 b2 a3 b3 a4 b4 a5 b5 a6 b6 a7 b7) (A2 s0 (AD c a1 b1) a2 b2 a3 b3 a4 b4 a5 b5 a6 b6 a7 b7)
(A2 s0 (P s1 c) a2 b2 a3 b3 a4 b4 a5 b5 a6 b6 a7 b7) (A3 s0 s1 (AD c a2 b2) a3 b3 a4 b4 a5 b5 a6 b6 a7 b7)
(A3 s0 s1 (P s2 c) a3 b3 a4 b4 a5 b5 a6 b6 a7 b7) (A4 s0 s1 s2 (AD c a3 b3) a4 b4 a5 b5 a6 b6 a7 b7)
(A4 s0 s1 s2 (P s3 c) a4 b4 a5 b5 a6 b6 a7 b7) (A5 s0 s1 s2 s3 (AD c a4 b4) a5 b5 a6 b6 a7 b7)
(A5 s0 s1 s2 s3 (P s4 c) a5 b5 a6 b6 a7 b7) (A6 s0 s1 s2 s3 s4 (AD c a5 b5) a6 b6 a7 b7)
(A6 s0 s1 s2 s3 s4 (P s5 c) a6 b6 a7 b7) (A7 s0 s1 s2 s3 s4 s5 (AD c a6 b6) a7 b7)
(A7 s0 s1 s2 s3 s4 s5 (P s6 c) a7 b7) (A8 s0 s1 s2 s3 s4 s5 s6 (AD c a7 b7))
(A8 s0 s1 s2 s3 s4 s5 s6 (P s7 c)) (N s0 s1 s2 s3 s4 s5 s6 s7)

; Negate and subtract.
(Neg32 (N a0 a1 a2 a3 a4 a5 a6 a7)) (Add32 (N (ND a0) (ND a1) (ND a2) (ND a3) (ND a4) (ND a5) (ND a6) (ND a7)) (Small 1))
(Sub32 x y) (Add32 x (Neg32 y))

; Byte emission from numbers.
(LEB (N d0 d1 d2 d3 d4 d5 d6 d7)) (Bytes (HB d1 d0) (HB d3 d2) (HB d5 d4) (HB d7 d6))
(LowByte (N d0 d1 d2 d3 d4 d5 d6 d7)) (HB d1 d0)

; Checked rel8: in-range offsets only, else the term stays stuck.
(Rel8 (N d0 d1 0 0 0 0 0 0)) (R8Ck (R8P d1) (HB d1 d0))
(Rel8 (N d0 d1 F F F F F F)) (R8Ck (R8N d1) (HB d1 d0))
(R8Ck OK b) b

; Alignment padding.
(Pad4 (N d0 d1 d2 d3 d4 d5 d6 d7)) (Small (PadDig4 d0))
(Pad8 (N d0 d1 d2 d3 d4 d5 d6 d7)) (Small (PadDig8 d0))
(PadOut (N 0 0 0 0 0 0 0 0)) (Bytes)
(PadOut (N 1 0 0 0 0 0 0 0)) (Bytes 00)
(PadOut (N 2 0 0 0 0 0 0 0)) (Bytes 00 00)
(PadOut (N 3 0 0 0 0 0 0 0)) (Bytes 00 00 00)
(PadOut (N 4 0 0 0 0 0 0 0)) (Bytes 00 00 00 00)
(PadOut (N 5 0 0 0 0 0 0 0)) (Bytes 00 00 00 00 00)
(PadOut (N 6 0 0 0 0 0 0 0)) (Bytes 00 00 00 00 00 00)
(PadOut (N 7 0 0 0 0 0 0 0)) (Bytes 00 00 00 00 00 00 00)

; Symbol table: keys are arbitrary terms, matched structurally.
(Lookup name (Bind other pc rest)) (Lookup name rest)
(Lookup name (Bind name pc rest)) pc

; Virtual addresses and ELF layout arithmetic.
(VBase) (X8 0 8 0 4 8 0 5 8)
(VAddr off) (Add32 (VBase) off)
(HdrSize) (X8 0 0 0 0 0 0 5 8)
(FileSz size) (Add32 (HdrSize) size)

; A single instruction specification. B=one byte, W=little-endian word,
; R=checked signed relative byte. Constructors are inert until emission;
; labels are resolved only after layout. Sizes derive solely from field types.
(Describe (Nop)) (Encoding ((B 90)))
(Describe (Ret)) (Encoding ((B C3)))
(Describe (Lodsb)) (Encoding ((B AC)))
(Describe (Stosb)) (Encoding ((B AA)))
(Describe (Stosl)) (Encoding ((B AB)))
(Describe (Movsb)) (Encoding ((B A4)))
(Describe (Cld)) (Encoding ((B FC)))
(Describe (Cdq)) (Encoding ((B 99)))
(Describe (Pushf)) (Encoding ((B 9C)))
(Describe (Popf)) (Encoding ((B 9D)))
(Describe (RepMovsb)) (Encoding ((B F3) (B A4)))
(Describe (RepeCmpsb)) (Encoding ((B F3) (B A6)))
(Describe (Int b)) (Encoding ((B CD) (B b)))
(Describe (TestALI8 b)) (Encoding ((B A8) (B b)))
(Describe (CmpALI8 b)) (Encoding ((B 3C) (B b)))
(Describe (IncR r)) (Encoding ((B (IncB r))))
(Describe (DecR r)) (Encoding ((B (DecB r))))
(Describe (PushR r)) (Encoding ((B (PushB r))))
(Describe (PopR r)) (Encoding ((B (PopB r))))
(Describe (XchgEaxR r)) (Encoding ((B (XchgAB r))))
; Ordinary reg/reg forms encode source in reg, destination in rm.
(Describe (MovRR d s)) (Encoding ((B 89) (B (RM11 s d))))
(Describe (AddRR d s)) (Encoding ((B 01) (B (RM11 s d))))
(Describe (SubRR d s)) (Encoding ((B 29) (B (RM11 s d))))
(Describe (CmpRR d s)) (Encoding ((B 39) (B (RM11 s d))))
(Describe (TestRR d s)) (Encoding ((B 85) (B (RM11 s d))))
(Describe (XorRR d s)) (Encoding ((B 31) (B (RM11 s d))))
(Describe (OrRR d s)) (Encoding ((B 09) (B (RM11 s d))))
(Describe (AndRR d s)) (Encoding ((B 21) (B (RM11 s d))))
(Describe (XchgRR d s)) (Encoding ((B 87) (B (RM11 s d))))
; 83 sign-extends its immediate byte; C1 uses the raw shift-count byte.
(Describe (AddI8 r b)) (Encoding ((B 83) (B (RMX 0 r)) (B b)))
(Describe (OrI8 r b)) (Encoding ((B 83) (B (RMX 1 r)) (B b)))
(Describe (AdcI8 r b)) (Encoding ((B 83) (B (RMX 2 r)) (B b)))
(Describe (SbbI8 r b)) (Encoding ((B 83) (B (RMX 3 r)) (B b)))
(Describe (AndI8 r b)) (Encoding ((B 83) (B (RMX 4 r)) (B b)))
(Describe (SubI8 r b)) (Encoding ((B 83) (B (RMX 5 r)) (B b)))
(Describe (XorI8 r b)) (Encoding ((B 83) (B (RMX 6 r)) (B b)))
(Describe (CmpI8 r b)) (Encoding ((B 83) (B (RMX 7 r)) (B b)))
(Describe (ShlI8 r b)) (Encoding ((B C1) (B (RMX 4 r)) (B b)))
(Describe (ShrI8 r b)) (Encoding ((B C1) (B (RMX 5 r)) (B b)))
(Describe (SarI8 r b)) (Encoding ((B C1) (B (RMX 7 r)) (B b)))
(Describe (NotR r)) (Encoding ((B F7) (B (RMX 2 r))))
(Describe (NegR r)) (Encoding ((B F7) (B (RMX 3 r))))
(Describe (MulR r)) (Encoding ((B F7) (B (RMX 4 r))))
(Describe (DivR r)) (Encoding ((B F7) (B (RMX 6 r))))
(Describe (IDivR r)) (Encoding ((B F7) (B (RMX 7 r))))
; Byte register encodings 4..7 mean AH/CH/DH/BH on i386, not SPL/BPL/SIL/DIL.
(Describe (TestRI8 r b)) (Encoding ((B F6) (B (RMX 0 r)) (B b)))
(Describe (IMulRR d s)) (Encoding ((B 0F) (B AF) (B (RM11 d s))))
(Describe (CallR r)) (Encoding ((B FF) (B (RMX 2 r))))
(Describe (JmpR r)) (Encoding ((B FF) (B (RMX 4 r))))
(Describe (PushI32 x)) (Encoding ((B 68) (W (Lit x))))
(Describe (PushI8 b)) (Encoding ((B 6A) (B b)))
(Describe (AddI32 r x)) (Encoding ((B 81) (B (RMX 0 r)) (W (Lit x))))
(Describe (AndI32 r x)) (Encoding ((B 81) (B (RMX 4 r)) (W (Lit x))))
(Describe (SubI32 r x)) (Encoding ((B 81) (B (RMX 5 r)) (W (Lit x))))
(Describe (CmpI32 r x)) (Encoding ((B 81) (B (RMX 7 r)) (W (Lit x))))
(Describe (MovRI r x)) (Encoding ((B (MovIB r)) (W (Lit x))))
(Describe (MovRILabel r l)) (Encoding ((B (MovIB r)) (W (Abs l))))
(Describe (MovRIConst r l)) (Encoding ((B (MovIB r)) (W (Tagged l (Small 1)))))
(Describe (MovRM r b)) (Encoding ((B 8B) (B (RM00 b r))))
(Describe (MovMR b r)) (Encoding ((B 89) (B (RM00 b r))))
(Describe (MovRMD r b d)) (Encoding ((B 8B) (B (RM01 b r)) (B d)))
(Describe (MovMDR b d r)) (Encoding ((B 89) (B (RM01 b r)) (B d)))
(Describe (MovzxRMb r b)) (Encoding ((B 0F) (B B6) (B (RM00 b r))))
(Describe (MovzxRMDb r b d)) (Encoding ((B 0F) (B B6) (B (RM01 b r)) (B d)))
(Describe (MovbMR b r)) (Encoding ((B 88) (B (RM00 b r))))
(Describe (LeaRMD r b d)) (Encoding ((B 8D) (B (RM01 b r)) (B d)))
(Describe (MovRMemL r l)) (Encoding ((B 8B) (B (RM05 r)) (W (Abs l))))
(Describe (MovMemLR l r)) (Encoding ((B 89) (B (RM05 r)) (W (Abs l))))
(Describe (CmpEaxI32 x)) (Encoding ((B 3D) (W (Lit x))))
(Describe (CmpEaxLabel l)) (Encoding ((B 3D) (W (Abs l))))
(Describe (Db b)) (Encoding ((B b)))
(Describe (Dd x)) (Encoding ((W (Lit x))))
(Describe (DLabel l)) (Encoding ((W (Abs l))))
(Describe (DConst l)) (Encoding ((W (Tagged l (Small 1)))))
; DNil emits 01; Scheme nil is 03.
(Describe (DNil)) (Encoding ((W (Lit (Small 1)))))
(Describe (JmpS l)) (Encoding ((B EB) (R (Relative l))))
(Describe (Jz l)) (Encoding ((B 74) (R (Relative l))))
(Describe (Jnz l)) (Encoding ((B 75) (R (Relative l))))
(Describe (Jb l)) (Encoding ((B 72) (R (Relative l))))
(Describe (Jae l)) (Encoding ((B 73) (R (Relative l))))
(Describe (Jbe l)) (Encoding ((B 76) (R (Relative l))))
(Describe (Ja l)) (Encoding ((B 77) (R (Relative l))))
(Describe (Js l)) (Encoding ((B 78) (R (Relative l))))
(Describe (Jns l)) (Encoding ((B 79) (R (Relative l))))
(Describe (Jl l)) (Encoding ((B 7C) (R (Relative l))))
(Describe (Jge l)) (Encoding ((B 7D) (R (Relative l))))
(Describe (Jle l)) (Encoding ((B 7E) (R (Relative l))))
(Describe (Jg l)) (Encoding ((B 7F) (R (Relative l))))
(Describe (Jmp32 l)) (Encoding ((B E9) (W (Relative l))))
(Describe (Call l)) (Encoding ((B E8) (W (Relative l))))
(Describe (Jz32 l)) (Encoding ((B 0F) (B 84) (W (Relative l))))
(Describe (Jnz32 l)) (Encoding ((B 0F) (B 85) (W (Relative l))))
(Describe (Jb32 l)) (Encoding ((B 0F) (B 82) (W (Relative l))))
(Describe (Jae32 l)) (Encoding ((B 0F) (B 83) (W (Relative l))))
(Describe (Jbe32 l)) (Encoding ((B 0F) (B 86) (W (Relative l))))
(Describe (Ja32 l)) (Encoding ((B 0F) (B 87) (W (Relative l))))
(Describe (Jl32 l)) (Encoding ((B 0F) (B 8C) (W (Relative l))))
(Describe (Jge32 l)) (Encoding ((B 0F) (B 8D) (W (Relative l))))
(Describe (Jle32 l)) (Encoding ((B 0F) (B 8E) (W (Relative l))))
(Describe (Jg32 l)) (Encoding ((B 0F) (B 8F) (W (Relative l))))

; Measure once, without resolving addresses or allocating 32-bit intermediates.
; No instruction may exceed 15 bytes: a carry leaves MeasureNext unresolved.
(FieldWidth (B x)) 1
(FieldWidth (W x)) 4
(FieldWidth (R x)) 1
(Measure () n) n
(Measure (field . fields) n) (MeasureNext (AD O n (FieldWidth field)) fields)
(MeasureNext (P n O) fields) (Measure fields n)
(Seal (Encoding fields)) (Packed (Measure fields 0) fields)
(Size instruction) (PackedSize (Seal (Describe instruction)))
(PackedSize (Packed n fields)) (Small n)
(Size (Label name)) (Small 0)

; Prepare descriptors once and share them between layout and emission.
(Prepare End) End
(Prepare (Ins instruction rest)) (Ins (Seal (Describe instruction)) (Prepare rest))
(Prepare (Ins (Label name) rest)) (Ins (Label name) (Prepare rest))
(Prepare (Ins (Align4) rest)) (Ins (Align4) (Prepare rest))
(Prepare (Ins (Align8) rest)) (Ins (Align8) (Prepare rest))
(LayoutPass End pc sym) (Layout sym pc)
(LayoutPass (Ins (Packed n fields) rest) pc sym) (LayoutPass rest (Add32 pc (Small n)) sym)
(LayoutPass (Ins (Label name) rest) pc sym) (LayoutPass rest pc (Bind name pc sym))
(LayoutPass (Ins (Align4) rest) pc sym) (LayoutPass rest (Add32 pc (Pad4 pc)) sym)
(LayoutPass (Ins (Align8) rest) pc sym) (LayoutPass rest (Add32 pc (Pad8 pc)) sym)

; Relative operands use the end of the instruction.
(Resolve (Lit value) next sym) value
(Resolve (Abs label) next sym) (VAddr (Lookup label sym))
(Resolve (Tagged label tag) next sym) (Add32 (VAddr (Lookup label sym)) tag)
(Resolve (Relative label) next sym) (Sub32 (Lookup label sym) next)
(OutField (B byte) next sym) byte
; Reject variable-length byte streams in one-byte fields.
(OutField (B (Bytes . bytes)) next sym) (InvalidByteOperand)
(OutField (W value) next sym) (LEB (Resolve value next sym))
(OutField (R value) next sym) (Rel8 (Resolve value next sym))
(OutFields () next sym) (Bytes)
(OutFields (field . fields) next sym) (Bytes (OutField field next sym) (OutFields fields next sym))
(EmitCode End pc sym) (Bytes)
(EmitCode (Ins (Label name) rest) pc sym) (EmitCode rest pc sym)
(EmitCode (Ins (Packed n fields) rest) pc sym) (EmitStep fields rest (Add32 pc (Small n)) sym)
(EmitStep fields rest next sym) (Bytes (OutFields fields next sym) (EmitCode rest next sym))
(EmitCode (Ins (Align4) rest) pc sym) (EmitPad (Pad4 pc) rest pc sym)
(EmitCode (Ins (Align8) rest) pc sym) (EmitPad (Pad8 pc) rest pc sym)
(EmitPad pad rest pc sym) (Bytes (PadOut pad) (EmitCode rest (Add32 pc pad) sym))

; i386 ELF header: one RWE load segment, optional BSS.
(ElfHeader entryoff codesize bss) (Bytes 7F 45 4C 46 01 01 01 00 00 00 00 00 00 00 00 00 02 00 03 00 01 00 00 00 (LEB (VAddr entryoff)) 34 00 00 00 00 00 00 00 00 00 00 00 34 00 20 00 01 00 00 00 00 00 00 00 01 00 00 00 00 00 00 00 00 80 04 08 00 80 04 08 (LEB (FileSz codesize)) (LEB (Add32 (FileSz codesize) bss)) 07 00 00 00 00 10 00 00 00 00 00 00)

; Keep unresolved assembly under Bytes so the seed rejects it.
(Assemble . invalid) (Bytes (InvalidProgram))
(Assemble (Program entry code)) (Assemble (Program entry (Small 0) code))
(Assemble (Program entry bss code)) (Bytes (AssemblePrepared entry bss (Prepare code)))
(AssemblePrepared entry bss code) (AssembleLayout entry bss code (LayoutPass code (Small 0) Empty))
(AssembleLayout entry bss code (Layout sym size)) (Bytes (ElfHeader (Lookup entry sym) size bss) (EmitCode code (Small 0) sym))
