; Layout pass: label addresses as code offsets.
(Pass1 End pc sym) sym
(Pass1 (Ins instr rest) pc sym) (Pass1 rest (Add32 pc (Size instr)) sym)
(Pass1 (Ins (Label name) rest) pc sym) (Pass1 rest pc (Bind name pc sym))
(Pass1 (Ins (Align4) rest) pc sym) (Pass1 rest (Add32 pc (Pad4 pc)) sym)
(Pass1 (Ins (Align8) rest) pc sym) (Pass1 rest (Add32 pc (Pad8 pc)) sym)

; Code size pass.
(CodeSize End pc) pc
(CodeSize (Ins instr rest) pc) (CodeSize rest (Add32 pc (Size instr)))
(CodeSize (Ins (Align4) rest) pc) (CodeSize rest (Add32 pc (Pad4 pc)))
(CodeSize (Ins (Align8) rest) pc) (CodeSize rest (Add32 pc (Pad8 pc)))

; Emission pass.
(Pass2 End pc sym) (Bytes)
(Pass2 (Ins (Label name) rest) pc sym) (Pass2 rest pc sym)
(Pass2 (Ins (Align4) rest) pc sym) (Bytes (PadOut (Pad4 pc)) (Pass2 rest (Add32 pc (Pad4 pc)) sym))
(Pass2 (Ins (Align8) rest) pc sym) (Bytes (PadOut (Pad8 pc)) (Pass2 rest (Add32 pc (Pad8 pc)) sym))
(Pass2 (Ins (Nop) rest) pc sym) (Bytes 90 (Pass2 rest (Add32 pc (Small 1)) sym))
(Pass2 (Ins (Ret) rest) pc sym) (Bytes C3 (Pass2 rest (Add32 pc (Small 1)) sym))
(Pass2 (Ins (Lodsb) rest) pc sym) (Bytes AC (Pass2 rest (Add32 pc (Small 1)) sym))
(Pass2 (Ins (Stosb) rest) pc sym) (Bytes AA (Pass2 rest (Add32 pc (Small 1)) sym))
(Pass2 (Ins (Stosl) rest) pc sym) (Bytes AB (Pass2 rest (Add32 pc (Small 1)) sym))
(Pass2 (Ins (Movsb) rest) pc sym) (Bytes A4 (Pass2 rest (Add32 pc (Small 1)) sym))
