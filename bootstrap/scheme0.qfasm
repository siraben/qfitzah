    (Label (RE 7))
    (CmpALI8 2D)
    (Jnz (RE 9))
    (PushR EAX)
    (Call PeekCh)
    (CmpALI8 30)
    (Jb (RE 8))
    (CmpALI8 39)
    (Ja (RE 8))
    (PopR EAX)
    (Call ReadCh)
    (MovRI ECX (Small 1))
    (Jmp32 ReadNum)
    (Label (RE 8))
    (PopR EAX)
    (Label (RE 9))
    (Jmp32 ReadSym)
    (Label ReadNum)
    (PushR ECX)
    (SubI8 EAX 30)
    (MovRR ECX EAX)
    (Label (RN 1))
