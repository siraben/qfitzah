; scheme0: Stage 2 Scheme interpreter.
; Load qfasm.qf1 and runtime-support.qf1 first.
; Register ABI: EAX/ECX/EDX arguments/results; EBX/ESI/EDI scratch.
; Cons preserves ECX/EDX; ReadCh/PeekCh/Emit preserve EBX/ECX/EDX.
; Interpreted closures hold (params . (body . env)); primitives use subtype 3.
; See ARCHITECTURE.md for the runtime layout.
(Rule (Scheme0Code)
  (Block (
    ; Round CodeEnd to an 8-byte boundary, then partition the BSS arena:
    ; 192 MiB cells, 32 MiB byte objects, 16 MiB read buffer, then token space.
    (Label Start)
    (MovRILabel EAX CodeEnd)
    (AddI8 EAX 07)
    (AndI8 EAX F8)
    (MovMemLR GCellFree EAX)
    (AddI32 EAX (X8 0 C 0 0 0 0 0 0))
    (MovMemLR GByteFree EAX)
    (AddI32 EAX (X8 0 2 0 0 0 0 0 0))
    (MovMemLR GReadBuf EAX)
    (MovMemLR GInPtr EAX)
    (MovMemLR GInEnd EAX)
    (AddI32 EAX (X8 0 1 0 0 0 0 0 0))
    (MovMemLR GTokBuf EAX)
    (ForSpecials Init (SpecialForms))
    (ForPrimitives Interpreted (CorePrimitives))
    (Label MainLoop)
    (Call ReadExpr)
    (CmpEaxI32 (X8 0 0 0 0 0 0 3 3))
    (Jnz (M 1))
    (MovRI EAX (Small 1))
    (XorRR EBX EBX)
    (Int 80)
    (Label (M 1))
    (MovRMemL ECX GEnv)
    (Call Eval)
    (CmpEaxI32 (X8 0 0 0 0 0 0 4 3))
    (Jz MainLoop2)
    (Call Print)
    (MovRI EAX (Small A))
    (Call Emit)
    (Label MainLoop2)
    (Jmp32 MainLoop)
    ; EAX=symbol, ECX=entry address. Install a subtype-3 object in GEnv.
    (Label DefPrim)
    (PushR EAX)
    (MovRR EAX ECX)
    (OrI8 EAX 03)
    (MovRI ECX (Small 1))
    (Call Cons)
    (OrI8 EAX 02)
    (MovRR ECX EAX)
    (PopR EAX)
    (Call Cons)
    (MovRMemL ECX GEnv)
    (Call Cons)
    (MovMemLR GEnv EAX)
    (Ret)
    (Label Emit)
    (PushR EBX)
    (PushR ECX)
    (PushR EDX)
    (MovRILabel ECX WriteChBuf)
    (MovbMR ECX EAX)
    (MovRI EAX (Small 4))
    (MovRI EBX (Small 1))
    (MovRI EDX (Small 1))
    (Int 80)
    (PopR EDX)
    (PopR ECX)
    (PopR EBX)
    (Ret)
    ; write(1, ECX, EDX); clobbers EAX/EBX.
    (Label PrintRaw)
    (MovRI EAX (Small 4))
    (MovRI EBX (Small 1))
    (Int 80)
    (Ret)
    (Label ErrTok)
    (MovRI EAX (X8 0 0 0 0 0 0 2 1))
    (Call Emit)
    (MovRI EAX (Small A))
    (Call Emit)
    (MovRI EAX (Small 1))
    (MovRI EBX (Small 1))
    (Int 80)
    (Label Cons)
    (PushR EDX)
    (MovRMemL EDX GCellFree)
    (MovMR EDX EAX)
    (MovMDR EDX 04 ECX)
    (MovRR EAX EDX)
    (AddI8 EDX 08)
    (MovMemLR GCellFree EDX)
    (PopR EDX)
    (Ret)
    (Label AllocObj)
    (PushR EDX)
    (MovRMemL EDI GByteFree)
    (PushR EDI)
    (MovRR ESI EAX)
    (PushR ECX)
    (RepMovsb)
    (PopR ECX)
    (MovRR EAX EDI)
    (AddI8 EAX 07)
    (AndI8 EAX F8)
    (MovMemLR GByteFree EAX)
    (PopR EAX)
    (PopR EDX)
    (OrRR EAX EDX)
    (PushR EAX)
    (MovRR EAX ECX)
    (ShlI8 EAX 02)
    (OrI8 EAX 01)
    (MovRR ECX EAX)
    (PopR EAX)
    (Call Cons)
    (OrI8 EAX 02)
    (Ret)
    (Label ReadCh)
    (MovRMemL EAX GPeek)
    (CmpEaxI32 (X8 F F F F F F F F))
    (Jz (RC 1))
    (PushR ECX)
    (MovRI ECX (X8 F F F F F F F F))
    (MovMemLR GPeek ECX)
    (PopR ECX)
    (Ret)
    (Label (RC 1))
    (PushR ECX)
    (MovRMemL EAX GInPtr)
    (MovRMemL ECX GInEnd)
    (CmpRR EAX ECX)
    (Jnz (RC 3))
    (PushR EBX)
    (PushR EDX)
    (MovRI EAX (Small 3))
    (XorRR EBX EBX)
    (MovRMemL ECX GReadBuf)
    (MovRI EDX (X8 0 1 0 0 0 0 0 0))
    (Int 80)
    (TestRR EAX EAX)
    (Jg (RC 2))
    (PopR EDX)
