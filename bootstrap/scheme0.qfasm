    (TestRR ECX ECX)
    (Jz (RN 3))
    (NegR EAX)
    (Label (RN 3))
    (ShlI8 EAX 02)
    (OrI8 EAX 01)
    (Ret)
    (Label ReadList)
    (Call SkipWS)
    (Call PeekCh)
    (CmpALI8 29)
    (Jnz (RL 1))
    (Call ReadCh)
    (MovRI EAX (Small 3))
    (Ret)
