    (Label (RC 2))
    (MovRMemL ECX GReadBuf)
    (MovMemLR GInPtr ECX)
    (AddRR ECX EAX)
    (MovMemLR GInEnd ECX)
    (PopR EDX)
    (PopR EBX)
    (MovRMemL EAX GInPtr)
    (Label (RC 3))
    (MovRR ECX EAX)
    (MovzxRMb EAX ECX)
    (IncR ECX)
    (MovMemLR GInPtr ECX)
    (PopR ECX)
    (Ret)
    (Label PeekCh)
    (Call ReadCh)
    (MovMemLR GPeek EAX)
    (Ret)
    (Label SkipWS)
    (Label (SW 1))
    (Call ReadCh)
