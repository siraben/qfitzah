; Non-allocating identity lookups for rsc. Private %assq/%memq return fixnum -1
; on malformed traversed lists; public Scheme wrappers raise catchable errors.
; Environments use the raw helpers on their private, always-proper alists.
(Rule (LookupCode)
  ((PrimitiveEntry PrIdentityHash)
   ; Stable under the nonmoving collector; collisions are permitted.
   (MovRM EAX EAX)
   (Label (RawPrimitive %identity-hash))
   (ShrI8 EAX 04)
   (ShlI8 EAX 02)
   (OrI8 EAX 01)
   (Ret)

   (PrimitiveEntry PrAssocQ)
   (MovRM EBX EAX)
   (MovRMD EAX EAX 04)
   (MovRM EAX EAX)
   (Label LookupAssocLoop)
   (CmpEaxI32 (SchemeNil))
   (Jz LookupFalse)
   (TestRI8 EAX 03)
   (Jnz LookupBad)
   (MovRM ECX EAX)
   (TestRI8 ECX 03)
   (Jnz LookupBad)
   (MovRM EDX ECX)
   (CmpRR EBX EDX)
   (Jz LookupAssocFound)
   (MovRMD EAX EAX 04)
   (JmpS LookupAssocLoop)
   (Label LookupAssocFound)
   (MovRR EAX ECX)
   (Ret)

   (PrimitiveEntry PrMemberQ)
   (MovRM EBX EAX)
   (MovRMD EAX EAX 04)
   (MovRM EAX EAX)
   (Label LookupMemberLoop)
   (CmpEaxI32 (SchemeNil))
   (Jz LookupFalse)
   (TestRI8 EAX 03)
   (Jnz LookupBad)
   (MovRM ECX EAX)
   (CmpRR EBX ECX)
   (Jz LookupMemberFound)
   (MovRMD EAX EAX 04)
   (JmpS LookupMemberLoop)
   (Label LookupMemberFound)
   (Ret)
   (Label LookupFalse)
   (MovRI EAX (SchemeFalse))
   (Ret)
   (Label LookupBad)
   (MovRI EAX (X8 F F F F F F F D))
   (Ret)

   ; Private host environment search: (frame, identity key, slot 0 or 1).
   ; Frames/alists are host-owned, well-formed objects. No allocation, so no
   ; temporary Scheme argument lists or environments at each lexical level.
   ; Parent takes precedence over fallback, exactly as the Scheme definition.
   (PrimitiveEntry PrEnvFind)
   (MovRMD ECX EAX 04)
   (MovRM EBX ECX)
   (MovRMD ECX ECX 04)
   (MovRM EDX ECX)
   (AndI8 EDX FC)
   (MovRM EAX EAX)
   (Label LookupEnvFrame)
   (CmpEaxI32 (SchemeFalse))
   (Jz LookupEnvReturn)
   (MovRR ECX EAX)
   (SubI8 ECX 02)
   (MovRM ESI ECX)
   (AndI8 ESI F8)
   (MovRR EAX ESI)
   (AddRR EAX EDX)
   (MovRM EAX EAX)
   (Label LookupEnvAlist)
   (CmpEaxI32 (SchemeNil))
   (Jz LookupEnvParent)
   (MovRM ECX EAX)
   (MovRM EDI ECX)
   (CmpRR EBX EDI)
   (Jz LookupEnvFound)
   (MovRMD EAX EAX 04)
   (JmpS LookupEnvAlist)
   (Label LookupEnvFound)
   (MovRMD EAX ECX 04)
   (Ret)
   (Label LookupEnvParent)
   (MovRMD ECX ESI 0C)
   (MovRMD EAX ESI 08)
   (CmpI32 ECX (SchemeFalse))
   (Jz LookupEnvFrame)
   (PushR ECX)
   (Call LookupEnvFrame)
   (PopR ECX)
   (CmpEaxI32 (SchemeFalse))
   (Jnz LookupEnvReturn)
   (MovRR EAX ECX)
   (JmpS LookupEnvFrame)
   (Label LookupEnvReturn)
   (Ret)
   (Label (RawPrimitive %env-find))
   (MovRR EBX ECX)
   (AndI8 EDX FC)
   (Jmp32 LookupEnvFrame)
   (Label (RawPrimitive %assq))
   (MovRR EBX EAX)
   (MovRR EAX ECX)
   (Jmp32 LookupAssocLoop)
   (Label (RawPrimitive %memq))
   (MovRR EBX EAX)
   (MovRR EAX ECX)
   (Jmp32 LookupMemberLoop)))
