; sc1-runtime: assembly runtime for Stage 3.
; Requires qfasm.qf1 and runtime-support.qf1. Primitive initialization and
; storage come from one descriptor list, expanded by Qfitzah.
; Compiled ABI: EBP=environment frames; EAX=argument list; EDI=captured env.
; A subtype-2 callable holds (code . env); primitives consume EAX and RET.
; See ARCHITECTURE.md for the runtime layout.

; DObj/MovRIObj descriptors (address + 2) live in runtime-support.qf1.

(Rule (RuntimeCode rest)
  (Block (
    ; Bump arenas after CodeEnd: 192 MiB cells, 32 MiB bytes, 16 MiB input.
    (Label HeapInit)
    (MovRILabel EAX CodeEnd)
    (AddI8 EAX 07)
    (AndI8 EAX F8)
    (MovMemLR GCellFree EAX)
    (AddI32 EAX (X8 0 C 0 0 0 0 0 0))
    (MovMemLR GByteFree EAX)
    (AddI32 EAX (X8 0 2 0 0 0 0 0 0))
    (MovMemLR GReadBuf EAX)
    (MovMemLR GInPtr EAX)
    (MovMemLR GInEnd EAX)
    (AddI32 EAX (X8 0 1 0 0 0 0 0 0))
    (MovMemLR GTokBuf EAX)
    (Ret)
    (Label InitPrims)
    (ForPrimitives Compiled (CorePrimitives))
    (Ret)
    ; Cons(EAX, ECX) returns a pair, preserving ECX and EDX.
    (Label Cons)
    (PushR EDX)
    (MovRMemL EDX GCellFree)
    (MovMR EDX EAX)
    (MovMDR EDX 04 ECX)
    (MovRR EAX EDX)
    (AddI8 EDX 08)
    (MovMemLR GCellFree EDX)
    (PopR EDX)
    (Ret)
    ; Copy EAX/ECX (bytes/length), with subtype in EDX, into the byte arena.
    (Label AllocObj)
    (PushR EDX)
    (MovRMemL EDI GByteFree)
    (PushR EDI)
    (MovRR ESI EAX)
    (PushR ECX)
    (RepMovsb)
    (PopR ECX)
    (MovRR EAX EDI)
    (AddI8 EAX 07)
    (AndI8 EAX F8)
    (MovMemLR GByteFree EAX)
    (PopR EAX)
    (PopR EDX)
    (OrRR EAX EDX)
    (PushR EAX)
    (MovRR EAX ECX)
    (ShlI8 EAX 02)
    (OrI8 EAX 01)
    (MovRR ECX EAX)
    (PopR EAX)
    (Call Cons)
    (OrI8 EAX 02)
    (Ret)
    (Label ReadCh)
    (MovRMemL EAX GPeek)
    (CmpEaxI32 (X8 F F F F F F F F))
    (Jz (RC 1))
    (PushR ECX)
    (MovRI ECX (X8 F F F F F F F F))
    (MovMemLR GPeek ECX)
    (PopR ECX)
    (Ret)
    (Label (RC 1))
    (PushR ECX)
    (MovRMemL EAX GInPtr)
    (MovRMemL ECX GInEnd)
    (CmpRR EAX ECX)
    (Jnz (RC 3))
    (PushR EBX)
    (PushR EDX)
    (MovRI EAX (Small 3))
    (XorRR EBX EBX)
    (MovRMemL ECX GReadBuf)
    (MovRI EDX (X8 0 1 0 0 0 0 0 0))
    (Int 80)
    (TestRR EAX EAX)
    (Jg (RC 2))
    (PopR EDX)
    (PopR EBX)
    (PopR ECX)
    (MovRI EAX (X8 F F F F F F F F))
    (Ret)
    (Label (RC 2))
    (MovRMemL ECX GReadBuf)
    (MovMemLR GInPtr ECX)
    (AddRR ECX EAX)
    (MovMemLR GInEnd ECX)
    (PopR EDX)
    (PopR EBX)
    (MovRMemL EAX GInPtr)
    (Label (RC 3))
    (MovRR ECX EAX)
    (MovzxRMb EAX ECX)
    (IncR ECX)
    (MovMemLR GInPtr ECX)
    (PopR ECX)
    (Ret)
    (Label PeekCh)
    (Call ReadCh)
    (MovMemLR GPeek EAX)
    (Ret)
    (Label Emit)
    (PushR EBX)
    (PushR ECX)
    (PushR EDX)
    (MovRILabel ECX WriteChBuf)
    (MovbMR ECX EAX)
    (MovRI EAX (Small 4))
    (MovRI EBX (Small 1))
    (MovRI EDX (Small 1))
    (Int 80)
    (PopR EDX)
    (PopR ECX)
    (PopR EBX)
    (Ret)
    (Label PrintRaw)
    (MovRI EAX (Small 4))
    (MovRI EBX (Small 1))
    (Int 80)
    (Ret)
    (Label ErrApply)
    (MovRI EAX (X8 0 0 0 0 0 0 2 1))
    (Call Emit)
    (MovRI EAX (Small A))
    (Call Emit)
    (MovRI EAX (Small 1))
    (MovRI EBX (Small 1))
    (Int 80)
    (Label Intern)
    (MovRMemL EDX GObList)
    (Label (IN 1))
    (TestRI8 EDX 03)
    (Jz (IN 2))
    (XorRR EDX EDX)
    (Call AllocObj)
    (PushR EAX)
    (MovRMemL ECX GObList)
    (Call Cons)
    (MovMemLR GObList EAX)
    (PopR EAX)
    (Ret)
    (Label (IN 2))
    (MovRM EBX EDX)
    (MovRR EDI EBX)
    (SubI8 EDI 02)
    (MovRMD ESI EDI 04)
    (SarI8 ESI 02)
    (CmpRR ESI ECX)
    (Jnz (IN 3))
    (MovRM ESI EDI)
    (MovRR EDI EAX)
    (PushR ECX)
    (RepeCmpsb)
    (PopR ECX)
    (Jnz (IN 3))
    (MovRR EAX EBX)
    (Ret)
    (Label (IN 3))
    (MovRMD EDX EDX 04)
    (JmpS (IN 1))
    (PrimitiveEntry PrCons)
    (MovRMD ECX EAX 04)
    (MovRM ECX ECX)
    (MovRM EAX EAX)
    (Jmp32 Cons)
    (PrimitiveEntry PrCar)
    (MovRM EAX EAX)
    (TestRI8 EAX 03)
    (Jz (CAR 1))
    (Jmp32 ErrApply)
    (Label (CAR 1))
    (MovRM EAX EAX)
    (Ret)
    (PrimitiveEntry PrCdr)
    (MovRM EAX EAX)
    (TestRI8 EAX 03)
    (Jz (CDR 1))
    (Jmp32 ErrApply)
    (Label (CDR 1))
    (MovRMD EAX EAX 04)
    (Ret)
    (PrimitiveEntry PrSetCar)
    (MovRM ECX EAX)
    (MovRMD EAX EAX 04)
    (MovRM EAX EAX)
    (MovMR ECX EAX)
    (MovRI EAX (X8 0 0 0 0 0 0 4 3))
    (Ret)
    (PrimitiveEntry PrSetCdr)
    (MovRM ECX EAX)
    (MovRMD EAX EAX 04)
    (MovRM EAX EAX)
    (MovMDR ECX 04 EAX)
    (MovRI EAX (X8 0 0 0 0 0 0 4 3))
    (Ret)
    (PrimitiveEntry PrPairQ)
    (MovRM EAX EAX)
    (TestRI8 EAX 03)
    (Jz (PQ T))
    (JmpS (PQ F))
    (ReturnBoolean PQ)
    (PrimitiveEntry PrNullQ)
    (MovRM EAX EAX)
    (CmpEaxI32 (Small 3))
    (Jz (NQ T))
    (JmpS (NQ F))
    (ReturnBoolean NQ)
    (PrimitiveEntry PrEqQ)
    (MovRM ECX EAX)
    (MovRMD EAX EAX 04)
    (MovRM EAX EAX)
    (CmpRR EAX ECX)
    (Jz (EQ T))
    (JmpS (EQ F))
    (ReturnBoolean EQ)
    (PrimitiveEntry PrSymQ)
    (MovRM EAX EAX)
    (MovRR ECX EAX)
    (AndI8 ECX 03)
    (CmpI8 ECX 02)
    (Jnz (SYQ F))
    (SubI8 EAX 02)
    (MovRM EAX EAX)
    (TestRI8 EAX 07)
    (Jz (SYQ T))
    (JmpS (SYQ F))
    (ReturnBoolean SYQ)
    (PrimitiveEntry PrNumQ)
    (MovRM EAX EAX)
    (TestRI8 EAX 01)
    (Jz (NUQ F))
    (TestRI8 EAX 02)
    (Jz (NUQ T))
    (JmpS (NUQ F))
    (ReturnBoolean NUQ)
    (PrimitiveEntry PrStrQ)
    (MovRM EAX EAX)
    (MovRR ECX EAX)
    (AndI8 ECX 03)
    (CmpI8 ECX 02)
    (Jnz (STQ F))
    (SubI8 EAX 02)
    (MovRM EAX EAX)
    (AndI8 EAX 07)
    (CmpI8 EAX 01)
    (Jz (STQ T))
    (JmpS (STQ F))
    (ReturnBoolean STQ)
    (PrimitiveEntry PrCharQ)
    (MovRM EAX EAX)
    (AndI32 EAX (X8 0 0 0 0 0 0 F F))
    (CmpI8 EAX 53)
    (Jz (CHQ T))
    (JmpS (CHQ F))
    (ReturnBoolean CHQ)
    (PrimitiveEntry PrProcQ)
    (MovRM EAX EAX)
    (MovRR ECX EAX)
    (AndI8 ECX 03)
    (CmpI8 ECX 02)
    (Jnz (PCQ F))
    (SubI8 EAX 02)
    (MovRM EAX EAX)
    (AndI8 EAX 07)
    (CmpI8 EAX 02)
    (Jz (PCQ T))
    (CmpI8 EAX 03)
    (Jz (PCQ T))
    (JmpS (PCQ F))
    (ReturnBoolean PCQ)
    (PrimitiveEntry PrBoolQ)
    (MovRM EAX EAX)
    (CmpEaxI32 (X8 0 0 0 0 0 0 1 3))
    (Jz (BQ T))
    (CmpEaxI32 (X8 0 0 0 0 0 0 2 3))
    (Jz (BQ T))
    (JmpS (BQ F))
    (ReturnBoolean BQ)
    (PrimitiveEntry PrNot)
    (MovRM EAX EAX)
    (CmpEaxI32 (X8 0 0 0 0 0 0 2 3))
    (Jz (NO T))
    (JmpS (NO F))
    (ReturnBoolean NO)
    (PrimitiveEntry PrAdd)
    (MovRI ECX (Small 1))
    (Label (AD 1))
    (TestRI8 EAX 03)
    (Jnz (AD 2))
    (MovRM EDX EAX)
    (AddRR ECX EDX)
    (DecR ECX)
    (MovRMD EAX EAX 04)
    (JmpS (AD 1))
    (Label (AD 2))
    (MovRR EAX ECX)
    (Ret)
    (PrimitiveEntry PrSub)
    (MovRM ECX EAX)
    (MovRMD EAX EAX 04)
    (TestRI8 EAX 03)
    (Jz (SB 1))
    (MovRI EAX (Small 2))
    (SubRR EAX ECX)
    (Ret)
    (Label (SB 1))
    (MovRM EDX EAX)
    (SubRR ECX EDX)
    (IncR ECX)
    (MovRMD EAX EAX 04)
    (TestRI8 EAX 03)
    (Jz (SB 1))
    (MovRR EAX ECX)
    (Ret)
    (PrimitiveEntry PrMul)
    (MovRI ECX (Small 1))
    (Label (MU 1))
    (TestRI8 EAX 03)
    (Jnz (MU 2))
    (MovRM EDX EAX)
    (SarI8 EDX 02)
    (IMulRR ECX EDX)
    (MovRMD EAX EAX 04)
    (JmpS (MU 1))
    (Label (MU 2))
    (MovRR EAX ECX)
    (ShlI8 EAX 02)
    (OrI8 EAX 01)
    (Ret)
    (PrimitiveEntry PrQuot)
    (MovRM ECX EAX)
    (MovRMD EAX EAX 04)
    (MovRM EBX EAX)
    (MovRR EAX ECX)
    (SarI8 EAX 02)
    (SarI8 EBX 02)
    (Cdq)
    (IDivR EBX)
    (ShlI8 EAX 02)
    (OrI8 EAX 01)
    (Ret)
    (PrimitiveEntry PrRem)
    (MovRM ECX EAX)
    (MovRMD EAX EAX 04)
    (MovRM EBX EAX)
    (MovRR EAX ECX)
    (SarI8 EAX 02)
    (SarI8 EBX 02)
    (Cdq)
    (IDivR EBX)
    (MovRR EAX EDX)
    (ShlI8 EAX 02)
    (OrI8 EAX 01)
    (Ret)
    (ComparePrimitive PrNumEq NE Jz)
    (ComparePrimitive PrLt LTP Jl)
    (ComparePrimitive PrGt GTP Jg)
    (ComparePrimitive PrLe LEP Jle)
    (ComparePrimitive PrGe GEP Jge)
    (PrimitiveEntry PrDisplay)
    (MovRM EAX EAX)
    (MovRR ECX EAX)
    (AndI8 ECX 03)
    (CmpI8 ECX 02)
    (Jnz (DS 2))
    (MovRR EDX EAX)
    (SubI8 EDX 02)
    (MovRM ECX EDX)
    (MovRR EBX ECX)
    (AndI8 EBX 07)
    (CmpI8 EBX 01)
    (Jnz (DS 3))
    (AndI8 ECX F8)
    (MovRMD EDX EDX 04)
    (SarI8 EDX 02)
    (Call PrintRaw)
    (MovRI EAX (X8 0 0 0 0 0 0 4 3))
    (Ret)
    (Label (DS 2))
    (CmpI8 ECX 03)
    (Jnz (DS 3))
    (MovRR EDX EAX)
    (AndI32 EDX (X8 0 0 0 0 0 0 F F))
    (CmpI8 EDX 53)
    (Jnz (DS 3))
    (ShrI8 EAX 08)
    (Call Emit)
    (MovRI EAX (X8 0 0 0 0 0 0 4 3))
    (Ret)
    (Label (DS 3))
    (Call Print)
    (MovRI EAX (X8 0 0 0 0 0 0 4 3))
    (Ret)
    (PrimitiveEntry PrWrite)
    (MovRM EAX EAX)
    (Call Print)
    (MovRI EAX (X8 0 0 0 0 0 0 4 3))
    (Ret)
    (PrimitiveEntry PrNewline)
    (MovRI EAX (Small A))
    (Call Emit)
    (MovRI EAX (X8 0 0 0 0 0 0 4 3))
    (Ret)
    (PrimitiveEntry PrReadChar)
    (Call ReadCh)
    (CmpEaxI32 (X8 F F F F F F F F))
    (Jz (RDC 1))
    (ShlI8 EAX 08)
    (OrI8 EAX 53)
    (Ret)
    (Label (RDC 1))
    (MovRI EAX (X8 0 0 0 0 0 0 3 3))
    (Ret)
    (PrimitiveEntry PrPeekChar)
    (Call PeekCh)
    (CmpEaxI32 (X8 F F F F F F F F))
    (Jz (PKC 1))
    (ShlI8 EAX 08)
    (OrI8 EAX 53)
    (Ret)
    (Label (PKC 1))
    (MovRI EAX (X8 0 0 0 0 0 0 3 3))
    (Ret)
    (PrimitiveEntry PrEofQ)
    (MovRM EAX EAX)
    (CmpEaxI32 (X8 0 0 0 0 0 0 3 3))
    (Jz (EFQ T))
    (JmpS (EFQ F))
    (ReturnBoolean EFQ)
    (PrimitiveEntry PrCharInt)
    (MovRM EAX EAX)
    (ShrI8 EAX 08)
    (ShlI8 EAX 02)
    (OrI8 EAX 01)
    (Ret)
    (PrimitiveEntry PrIntChar)
    (MovRM EAX EAX)
    (SarI8 EAX 02)
    (ShlI8 EAX 08)
    (OrI8 EAX 53)
    (Ret)
    (PrimitiveEntry PrStrLen)
    (MovRM EAX EAX)
    (SubI8 EAX 02)
    (MovRMD EAX EAX 04)
    (Ret)
    (PrimitiveEntry PrStrRef)
    (MovRM ECX EAX)
    (MovRMD EAX EAX 04)
    (MovRM EDX EAX)
    (SubI8 ECX 02)
    (MovRM EBX ECX)
    (AndI8 EBX F8)
    (SarI8 EDX 02)
    (AddRR EBX EDX)
    (MovzxRMb EAX EBX)
    (ShlI8 EAX 08)
    (OrI8 EAX 53)
    (Ret)
    (PrimitiveEntry PrStrSym)
    (MovRM EAX EAX)
    (SubI8 EAX 02)
    (MovRR EDX EAX)
    (MovRM EAX EDX)
    (AndI8 EAX F8)
    (MovRMD ECX EDX 04)
    (SarI8 ECX 02)
    (Jmp32 Intern)
    (PrimitiveEntry PrSymStr)
    (MovRM EAX EAX)
    (SubI8 EAX 02)
    (MovRM EDX EAX)
    (OrI8 EDX 01)
    (MovRMD ECX EAX 04)
    (MovRR EAX EDX)
    (Call Cons)
    (OrI8 EAX 02)
    (Ret)
    (PrimitiveEntry PrListStr)
    (MovRM EDX EAX)
    (MovRMemL EDI GTokBuf)
    (Label (LS 1))
    (TestRI8 EDX 03)
    (Jnz (LS 2))
    (MovRM EAX EDX)
    (ShrI8 EAX 08)
    (MovbMR EDI EAX)
    (IncR EDI)
    (MovRMD EDX EDX 04)
    (JmpS (LS 1))
    (Label (LS 2))
    (MovRMemL EAX GTokBuf)
    (MovRR ECX EDI)
    (SubRR ECX EAX)
    (MovRI EDX (Small 1))
    (Jmp32 AllocObj)
    (PrimitiveEntry PrError)
    (Label (ER 1))
    (TestRI8 EAX 03)
    (Jnz (ER 2))
    (PushR EAX)
    (MovRM EAX EAX)
    (Call Print)
    (MovRI EAX (X8 0 0 0 0 0 0 2 0))
    (Call Emit)
    (PopR EAX)
    (MovRMD EAX EAX 04)
    (JmpS (ER 1))
    (Label (ER 2))
    (MovRI EAX (Small A))
    (Call Emit)
    (MovRI EAX (Small 1))
    (MovRI EBX (Small 1))
    (Int 80)
    (PrimitiveEntry PrExit)
    (TestRI8 EAX 03)
    (Jnz (EX 1))
    (MovRM EBX EAX)
    (SarI8 EBX 02)
    (MovRI EAX (Small 1))
    (Int 80)
    (Label (EX 1))
    (MovRI EAX (Small 1))
    (XorRR EBX EBX)
    (Int 80)
    (Label Print)
    (MovRR ECX EAX)
    (AndI8 ECX 03)
    (CmpI8 ECX 01)
    (Jnz (PR 1))
    (Jmp32 PrintNum)
    (Label (PR 1))
    (CmpI8 ECX 02)
    (Jnz (PR 2))
    (Jmp32 PrintObj)
    (Label (PR 2))
    (CmpI8 ECX 03)
    (Jnz (PR 3))
    (Jmp32 PrintImm)
    (Label (PR 3))
    (Jmp32 PrintPair)
    (Label PrintNum)
    (SarI8 EAX 02)
    (TestRR EAX EAX)
    (Jns (PN 1))
    (PushR EAX)
    (MovRI EAX (X8 0 0 0 0 0 0 2 D))
    (Call Emit)
    (PopR EAX)
    (NegR EAX)
    (Label (PN 1))
    (XorRR EBX EBX)
    (MovRI ECX (Small A))
    (Label (PN 2))
    (XorRR EDX EDX)
    (DivR ECX)
    (AddI8 EDX 30)
    (PushR EDX)
    (IncR EBX)
    (TestRR EAX EAX)
    (Jnz (PN 2))
    (Label (PN 3))
    (PopR EAX)
    (Call Emit)
    (DecR EBX)
    (Jnz (PN 3))
    (Ret)
    (Label PrintPair)
    (PushR EAX)
    (MovRI EAX (X8 0 0 0 0 0 0 2 8))
    (Call Emit)
    (PopR EAX)
    (Label (PP 1))
    (PushR EAX)
    (MovRM EAX EAX)
    (Call Print)
    (PopR EAX)
    (MovRMD EAX EAX 04)
    (TestRI8 EAX 03)
    (Jnz (PP 2))
    (PushR EAX)
    (MovRI EAX (X8 0 0 0 0 0 0 2 0))
    (Call Emit)
    (PopR EAX)
    (Jmp32 (PP 1))
    (Label (PP 2))
    (CmpEaxI32 (Small 3))
    (Jnz (PP 3))
    (MovRI EAX (X8 0 0 0 0 0 0 2 9))
    (Jmp32 Emit)
    (Label (PP 3))
    (PushR EAX)
    (MovRI EAX (X8 0 0 0 0 0 0 2 0))
    (Call Emit)
    (MovRI EAX (X8 0 0 0 0 0 0 2 E))
    (Call Emit)
    (MovRI EAX (X8 0 0 0 0 0 0 2 0))
    (Call Emit)
    (PopR EAX)
    (Call Print)
    (MovRI EAX (X8 0 0 0 0 0 0 2 9))
    (Jmp32 Emit)
    (Label PrintObj)
    (SubI8 EAX 02)
    (MovRM ECX EAX)
    (MovRMD EDX EAX 04)
    (SarI8 EDX 02)
    (MovRR EBX ECX)
    (AndI8 EBX 07)
    (TestRR EBX EBX)
    (Jnz (PO 1))
    (Jmp32 PrintRaw)
    (Label (PO 1))
    (CmpI8 EBX 01)
    (Jz (PO 2))
    (MovRI EAX (X8 0 0 0 0 0 0 3 F))
    (Jmp32 Emit)
    (Label (PO 2))
    (MovRI EAX (X8 0 0 0 0 0 0 2 2))
    (Call Emit)
    (AndI8 ECX F8)
    (Call PrintRaw)
    (MovRI EAX (X8 0 0 0 0 0 0 2 2))
    (Jmp32 Emit)
    (Label PrintImm)
    (CmpEaxI32 (Small 3))
    (Jnz (PI 1))
    (MovRI EAX (X8 0 0 0 0 0 0 2 8))
    (Call Emit)
    (MovRI EAX (X8 0 0 0 0 0 0 2 9))
    (Jmp32 Emit)
    (Label (PI 1))
    (CmpEaxI32 (X8 0 0 0 0 0 0 1 3))
    (Jnz (PI 2))
    (MovRI EAX (X8 0 0 0 0 0 0 2 3))
    (Call Emit)
    (MovRI EAX (X8 0 0 0 0 0 0 7 4))
    (Jmp32 Emit)
    (Label (PI 2))
    (CmpEaxI32 (X8 0 0 0 0 0 0 2 3))
    (Jnz (PI 3))
    (MovRI EAX (X8 0 0 0 0 0 0 2 3))
    (Call Emit)
    (MovRI EAX (X8 0 0 0 0 0 0 6 6))
    (Jmp32 Emit)
    (Label (PI 3))
    (MovRR ECX EAX)
    (AndI32 ECX (X8 0 0 0 0 0 0 F F))
    (CmpI8 ECX 53)
    (Jnz (PI 4))
    (PushR EAX)
    (MovRI EAX (X8 0 0 0 0 0 0 2 3))
    (Call Emit)
    (MovRI EAX (X8 0 0 0 0 0 0 5 C))
    (Call Emit)
    (PopR EAX)
    (ShrI8 EAX 08)
    (Jmp32 Emit)
    (Label (PI 4))
    (MovRI EAX (X8 0 0 0 0 0 0 3 F))
    (Jmp32 Emit)
  ) rest))

(Rule (RuntimeData rest)
  (Block (
    (Align4)
    (Label GCellFree)
    (Dd (X8 0 0 0 0 0 0 0 0))
    (Label GByteFree)
    (Dd (X8 0 0 0 0 0 0 0 0))
    (Label GInPtr)
    (Dd (X8 0 0 0 0 0 0 0 0))
    (Label GInEnd)
    (Dd (X8 0 0 0 0 0 0 0 0))
    (Label GObList)
    (Dd (X8 0 0 0 0 0 0 0 3))
    (Label GTokBuf)
    (Dd (X8 0 0 0 0 0 0 0 0))
    (Label GReadBuf)
    (Dd (X8 0 0 0 0 0 0 0 0))
    (Label GPeek)
    (Dd (X8 F F F F F F F F))
    (Label WriteChBuf)
    (Db 00)
    (Align4)
    (ForPrimitives Globals (CorePrimitives))
    (Align8)
    (Label CodeEnd)
  ) rest))
