; Nonmoving conservative allocator for rsc. Load after runtime-support.qf1.
; Every allocation: [total bytes, state, payload...], eight-byte aligned.
; State bits: 1 allocated, 2 marked, 4 atomic (byte payload, not scanned).
; Free state is zero. Minimum total size is 16 bytes.
; GOwners maps each eight-byte heap granule to its allocated block header.
; This protects tagged AND raw/interior pointers across allocation safepoints.
; No recursive marking, host allocator, or generated machine-code dependency.
;
; Two nonmoving arenas: blocks below 4 KiB use the small arena, larger blocks
; use the large arena. Small-object churn cannot fragment large-buffer space.
; GcHeapBytes is PER ARENA (power of two, 64 KiB..256 MiB). Default: 128 MiB
; each + 128 MiB owner map + 64 MiB mark queue + 8 MiB I/O. Neither arena
; borrows from the other; checked exhaustion remains possible in either one.
; Reserve twice the total arena space for blocks/owners/queue, plus I/O/slack.
(GcHeapBytes) (X8 0 8 0 0 0 0 0 0)
(GcArenaBytes) (Add32 (GcHeapBytes) (GcHeapBytes))
(GcMemoryBytes) (Add32 (Add32 (GcArenaBytes) (GcArenaBytes)) (X8 0 0 8 0 0 0 0 8))

(Rule (GcCode)
  ((Label HeapInit)
   (MovRR EAX ESP)
   (AddI8 EAX 04)
   (MovMemLR GStackTop EAX)
   (MovRILabel EAX CodeEnd)
   (AddI8 EAX 07)
   (AndI8 EAX F8)
   (MovMemLR GHeapStart EAX)
   (MovMemLR GHeapBump EAX)
   (MovRI ECX (GcHeapBytes))
   (AddRR EAX ECX)
   (MovMemLR GHeapEnd EAX)
   (MovMemLR GLargeStart EAX)
   (MovMemLR GLargeBump EAX)
   (AddRR EAX ECX)
   (MovMemLR GLargeEnd EAX)
   (MovMemLR GOwners EAX)
   (AddRR EAX ECX)
   (MovMemLR GWorkBase EAX)
   (ShrI8 ECX 01)
   (AddRR EAX ECX)
   (MovMemLR GWorkEnd EAX)
   (MovMemLR GReadBuf EAX)
   (MovMemLR GInPtr EAX)
   (MovMemLR GInEnd EAX)
   (AddI32 EAX (X8 0 0 4 0 0 0 0 0))
   (MovMemLR GTokBuf EAX)
   (Ret)

   ; AllocBytes(ECX length) -> EDI payload; preserves all other registers.
   ; Save registers before collection: callers may hold live raw pointers.
   (Label AllocBytes)
   (PushR EAX) (PushR EBX) (PushR ECX)
   (PushR EDX) (PushR ESI) (PushR EBP)
   (CmpI32 ECX (GcHeapBytes))
   (Jae32 GcOutOfMemory)
   (TestRR ECX ECX)
   (Jnz (GcAlloc Nonzero))
   (MovRI ECX (Small 8))
   (Label (GcAlloc Nonzero))
   (MovRR EBX ECX)
   (AddI8 EBX 0F)
   (AndI8 EBX F8)
   (XorRR EBP EBP)
   (Label (GcAlloc Retry))
   (Call GcFindFree)
   (TestRR EDI EDI)
   (Jnz (GcAlloc Claim))
   (MovRILabel ESI GHeapBump)
   (MovRMemL EDX GHeapEnd)
   (CmpI32 EBX (X8 0 0 0 0 1 0 0 0))
   (Jb (GcAlloc Bump))
   (MovRILabel ESI GLargeBump)
   (MovRMemL EDX GLargeEnd)
   (Label (GcAlloc Bump))
   (MovRM EDI ESI)
   (MovRR EAX EDI)
   (AddRR EAX EBX)
   (CmpRR EAX EDX)
   (Ja (GcAlloc Collect))
   (MovMR EDI EBX)
   (MovMR ESI EAX)
   (JmpS (GcAlloc Claim))
   (Label (GcAlloc Collect))
   (TestRR EBP EBP)
   (Jnz32 GcOutOfMemory)
   (Call Collect)
   (IncR EBP)
   (JmpS (GcAlloc Retry))
   (Label (GcAlloc Claim))
   (Call GcClaim)
   (AddI8 EDI 08)
   (PopR EBP) (PopR ESI) (PopR EDX)
   (PopR ECX) (PopR EBX) (PopR EAX)
   (Ret)

   ; Byte buffers have owners and survive raw/interior roots, but their bytes
   ; must not themselves retain arbitrary objects merely by looking like pointers.
   ; No allocation/collection occurs between claiming the block and tagging it.
   (Label AllocAtomic)
   (Call AllocBytes)
   (PushR EAX)
   (MovRI EAX (Small 5))
   (MovMDR EDI FC EAX)
   (PopR EAX)
   (Ret)

   ; Find/split a reusable block of at least EBX bytes. EDI=0 on failure.
   ; ESI points to the link which owns the current free-list node.
   (Label GcFindFree)
   (MovRILabel ESI GFreeList)
   (CmpI32 EBX (X8 0 0 0 0 1 0 0 0))
   (Jb (GcFree Next))
   (MovRILabel ESI GLargeFreeList)
   (Label (GcFree Next))
   (MovRM EDI ESI)
   (TestRR EDI EDI)
   (Jz (GcFree Done))
   (MovRM EAX EDI)
   (CmpRR EAX EBX)
   (Jae (GcFree Found))
   (MovRR ESI EDI)
   (AddI8 ESI 08)
   (JmpS (GcFree Next))
   (Label (GcFree Found))
   (SubRR EAX EBX)
   (MovRMD EDX EDI 08)
   (CmpI8 EAX 10)
   (Jb (GcFree Whole))
   (MovRR ECX EDI)
   (AddRR ECX EBX)
   (MovMR ECX EAX)
   (XorRR EAX EAX)
   (MovMDR ECX 04 EAX)
   (MovMDR ECX 08 EDX)
   (MovMR ESI ECX)
   (MovMR EDI EBX)
   (Ret)
   (Label (GcFree Whole))
   (MovMR ESI EDX)
   (Label (GcFree Done))
   (Ret)

   ; EDI header -> allocated, zeroed block, with complete owner metadata.
   (Label GcClaim)
   (MovRI EAX (Small 1))
   (MovMDR EDI 04 EAX)
   (MovRR ESI EDI)
   (MovRMemL EAX GHeapStart)
   (SubRR ESI EAX)
   (ShrI8 ESI 01)
   (MovRMemL EAX GOwners)
   (AddRR ESI EAX)
   (MovRM ECX EDI)
   (ShrI8 ECX 03)
   (Label (GcClaim Map))
   (MovMR ESI EDI)
   (AddI8 ESI 04)
   (DecR ECX)
   (Jnz (GcClaim Map))
   (MovRM ECX EDI)
   (SubI8 ECX 08)
   (MovRR ESI EDI)
   (AddI8 ESI 08)
   (XorRR EAX EAX)
   (Label (GcClaim Zero))
   (MovMR ESI EAX)
   (AddI8 ESI 04)
   (SubI8 ECX 04)
   (Jnz (GcClaim Zero))
   (Ret)

   ; Collection preserves every general register. The stack includes the
   ; register snapshot and all pending values held by compiled/runtime code.
   (Label Collect)
   (PushR EAX) (PushR EBX) (PushR ECX) (PushR EDX)
   (PushR ESI) (PushR EDI) (PushR EBP)
   (MovRMemL EAX GCollections)
   (IncR EAX)
   (MovMemLR GCollections EAX)
   (MovRMemL EAX GWorkBase)
   (MovMemLR GWorkTop EAX)
   (MovRR ESI ESP)
   (MovRMemL EDI GStackTop)
   (Call GcScan)
   ; Compiled text, literal data, and user global cells precede HeapInit.
   ; Allocator metadata is deliberately NOT scanned as program roots.
   (MovRILabel ESI Start)
   (MovRILabel EDI HeapInit)
   (Call GcScan)
   (MovRILabel ESI GPrimitiveRoots)
   (MovRILabel EDI GPrimitiveRootsEnd)
   (Call GcScan)
   (MovRMemL EAX GObList)
   (Call GcMark)
   (Call GcDrain)
   (Call GcSweep)
   (PopR EBP) (PopR EDI) (PopR ESI) (PopR EDX)
   (PopR ECX) (PopR EBX) (PopR EAX)
   (Ret)

   ; Scan aligned words [ESI,EDI). GcMark preserves the scan cursors.
   (Label GcScan)
   (CmpRR ESI EDI)
   (Jae (GcScan Done))
   (MovRM EAX ESI)
   (Call GcMark)
   (AddI8 ESI 04)
   (JmpS GcScan)
   (Label (GcScan Done))
   (Ret)

   ; Candidate EAX may be an arbitrary integer, tagged, raw, or interior.
   ; Clobbers EAX/EBX/ECX/EDX only; each traced block is queued once.
   ; Atomic buffers are marked through owners but never put on the scan queue.
   (Label GcMark)
   (MovRMemL ECX GHeapStart)
   (CmpRR EAX ECX)
   (Jb (GcMark Done))
   ; The unused gap between arenas has zero owners and cannot mark a block.
   (MovRMemL EDX GLargeBump)
   (CmpRR EAX EDX)
   (Jae (GcMark Done))
   (SubRR EAX ECX)
   (ShrI8 EAX 01)
   (AndI8 EAX FC)
   (MovRMemL ECX GOwners)
   (AddRR EAX ECX)
   (MovRM EBX EAX)
   (TestRR EBX EBX)
   (Jz (GcMark Done))
   (MovRMD ECX EBX 04)
   (TestRI8 ECX 01)
   (Jz (GcMark Done))
   (TestRI8 ECX 02)
   (Jnz (GcMark Done))
   (OrI8 ECX 02)
   (MovMDR EBX 04 ECX)
   (TestRI8 ECX 04)
   (Jnz (GcMark Done))
   (MovRMemL EDX GWorkTop)
   (MovRMemL ECX GWorkEnd)
   (CmpRR EDX ECX)
   (Jae32 GcOutOfMemory)
   (MovMR EDX EBX)
   (AddI8 EDX 04)
   (MovMemLR GWorkTop EDX)
   (Label (GcMark Done))
   (Ret)

   (Label GcDrain)
   (MovRMemL EAX GWorkTop)
   (MovRMemL ECX GWorkBase)
   (CmpRR EAX ECX)
   (Jz (GcDrain Done))
   (SubI8 EAX 04)
   (MovMemLR GWorkTop EAX)
   (MovRM ESI EAX)
   (MovRM EDI ESI)
   (AddRR EDI ESI)
   (AddI8 ESI 08)
   (Call GcScan)
   (JmpS GcDrain)
   (Label (GcDrain Done))
   (Ret)

   ; Sweep each arena independently; never coalesce across the unused gap.
   (Label GcSweep)
   (MovRMemL ESI GHeapStart)
   (MovRMemL EAX GHeapBump)
   (MovMemLR GSweepEnd EAX)
   (MovRILabel EAX GHeapBump)
   (MovMemLR GSweepBump EAX)
   (MovRILabel EBP GFreeList)
   (Call GcSweepRange)
   (MovRMemL ESI GLargeStart)
   (MovRMemL EAX GLargeBump)
   (MovMemLR GSweepEnd EAX)
   (MovRILabel EAX GLargeBump)
   (MovMemLR GSweepBump EAX)
   (MovRILabel EBP GLargeFreeList)
   (Jmp32 GcSweepRange)
   ; ESI=start, GSweepEnd=limit, EBP=&free-list; EDI=preceding free block.
   (Label GcSweepRange)
   (XorRR EDI EDI)
   (MovMDR EBP 00 EDI)
   (Label (GcSweep Next))
   (MovRMemL EAX GSweepEnd)
   (CmpRR ESI EAX)
   (Jae (GcSweep Done))
   (MovRM EBX ESI)
   (MovRMD EAX ESI 04)
   (TestRI8 EAX 02)
   (Jz (GcSweep Dead))
   (AndI8 EAX FD)
   (MovMDR ESI 04 EAX)
   (XorRR EDI EDI)
   (JmpS (GcSweep Advance))
   (Label (GcSweep Dead))
   (Call GcForget)
   (TestRR EDI EDI)
   (Jz (GcSweep Link))
   (MovRM EAX EDI)
   (AddRR EAX EBX)
   (MovMR EDI EAX)
   (JmpS (GcSweep Advance))
   (Label (GcSweep Link))
   (MovRMD EAX EBP 00)
   (MovMDR ESI 08 EAX)
   (MovMDR EBP 00 ESI)
   (MovRR EDI ESI)
   (Label (GcSweep Advance))
   (AddRR ESI EBX)
   (JmpS (GcSweep Next))
   (Label (GcSweep Done))
   ; The final free run is the list head. Return it to unused bump space so
   ; a future request can span both the dead tail and previously unused space.
   (TestRR EDI EDI)
   (Jz (GcSweep Return))
   (MovRMD EAX EDI 08)
   (MovMDR EBP 00 EAX)
   (MovRMemL EAX GSweepBump)
   (MovMR EAX EDI)
   (Label (GcSweep Return))
   (Ret)

   ; Clear metadata for dead block ESI of size EBX; preserve sweep cursors.
   (Label GcForget)
   (XorRR EAX EAX)
   (MovMDR ESI 04 EAX)
   (MovRR EDX ESI)
   (MovRMemL ECX GHeapStart)
   (SubRR EDX ECX)
   (ShrI8 EDX 01)
   (MovRMemL ECX GOwners)
   (AddRR EDX ECX)
   (MovRR ECX EBX)
   (ShrI8 ECX 03)
   (Label (GcForget Next))
   (MovMR EDX EAX)
   (AddI8 EDX 04)
   (DecR ECX)
   (Jnz (GcForget Next))
   (Ret)

   (PrimitiveEntry PrGc)
   (Call Collect)
   (MovRI EAX (SchemeUnspecified))
   (Ret)
   (PrimitiveEntry PrGcCount)
   (MovRMemL EAX GCollections)
   (ShlI8 EAX 02)
   (OrI8 EAX 01)
   (Ret)
   ; Diagnostic: collect, then count retained block bytes in eight-byte units.
   ; Units include headers/padding and fit a fixnum even for a full 512 MiB heap.
   ; Counting itself neither allocates nor retains a snapshot of the heap.
   (PrimitiveEntry PrGcLiveUnits)
   (Call Collect)
   (XorRR EAX EAX)
   (MovRMemL ESI GHeapStart)
   (MovRMemL EBX GHeapBump)
   (Call GcLiveRange)
   (MovRMemL ESI GLargeStart)
   (MovRMemL EBX GLargeBump)
   (Call GcLiveRange)
   (ShrI8 EAX 01)
   (OrI8 EAX 01)
   (Ret)
   ; Add allocated bytes in [ESI,EBX) to EAX, without allocating.
   (Label GcLiveRange)
   (Label (GcLive Next))
   (CmpRR ESI EBX)
   (Jae (GcLive Done))
   (MovRM ECX ESI)
   (MovRMD EDX ESI 04)
   (TestRI8 EDX 01)
   (Jz (GcLive Advance))
   (AddRR EAX ECX)
   (Label (GcLive Advance))
   (AddRR ESI ECX)
   (JmpS (GcLive Next))
   (Label (GcLive Done))
   (Ret)
   ; Largest contiguous available block, also in eight-byte units. Include
   ; unused bump space as well as swept free blocks; total free space alone
   ; cannot diagnose fragmentation in a nonmoving heap.
   (PrimitiveEntry PrGcLargestFreeUnits)
   (Call Collect)
   (MovRMemL EAX GHeapEnd)
   (MovRMemL EDX GHeapBump)
   (SubRR EAX EDX)
   (MovRMemL ESI GFreeList)
   (Call GcLargestList)
   (MovRMemL ECX GLargeEnd)
   (MovRMemL EDX GLargeBump)
   (SubRR ECX EDX)
   (CmpRR ECX EAX)
   (Jbe (GcLargest Large))
   (MovRR EAX ECX)
   (Label (GcLargest Large))
   (MovRMemL ESI GLargeFreeList)
   (Call GcLargestList)
   (ShrI8 EAX 01)
   (OrI8 EAX 01)
   (Ret)
   ; ESI=free list, EAX=current largest candidate.
   (Label GcLargestList)
   (Label (GcLargest Next))
   (TestRR ESI ESI)
   (Jz (GcLargest Done))
   (MovRM ECX ESI)
   (CmpRR ECX EAX)
   (Jbe (GcLargest Advance))
   (MovRR EAX ECX)
   (Label (GcLargest Advance))
   (MovRMD ESI ESI 08)
   (JmpS (GcLargest Next))
   (Label (GcLargest Done))
   (Ret)
   ; Deterministic stderr diagnostic and failure, never a corrupt ELF/heap.
   (Label GcOutOfMemory)
   (MovRI EAX (Small 4))
   (MovRI EBX (Small 2))
   (MovRILabel ECX GcErrorText)
   (MovRI EDX (X8 0 0 0 0 0 0 1 3))
   (Int 80)
   (MovRI EAX (Small 1))
   (MovRI EBX (Small 1))
   (Int 80)))

; Allocator metadata is not a root. Only program-owned static data is scanned.
(Rule (GcData)
  ((Align4)
   (Label GStackTop) (Dd (Small 0))
   (Label GHeapStart) (Dd (Small 0))
   (Label GHeapBump) (Dd (Small 0))
   (Label GHeapEnd) (Dd (Small 0))
   (Label GLargeStart) (Dd (Small 0))
   (Label GLargeBump) (Dd (Small 0))
   (Label GLargeEnd) (Dd (Small 0))
   (Label GLargeFreeList) (Dd (Small 0))
   (Label GSweepEnd) (Dd (Small 0))
   (Label GSweepBump) (Dd (Small 0))
   (Label GOwners) (Dd (Small 0))
   (Label GFreeList) (Dd (Small 0))
   (Label GWorkBase) (Dd (Small 0))
   (Label GWorkTop) (Dd (Small 0))
   (Label GWorkEnd) (Dd (Small 0))
   (Label GCollections) (Dd (Small 0))
   (Label GcErrorText)
   (Db 72) (Db 73) (Db 63) (Db 3A) (Db 20)
   (Db 6F) (Db 75) (Db 74) (Db 20) (Db 6F) (Db 66) (Db 20)
   (Db 6D) (Db 65) (Db 6D) (Db 6F) (Db 72) (Db 79) (Db 0A)))
