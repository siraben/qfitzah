; Small Linux/i386 I/O boundary for rsc-ports.scm. Load with gc.qf1.
; Syscall failures return their negative errno as a fixnum. Policy (retry,
; diagnostics, close/flush, string ports) belongs to the Scheme port layer.
; No libc, shell, host compiler or foreign-function bridge is involved.
(Rule (IoCode)
  ((PrimitiveEntry PrMakeSym)
   (MovRM EAX EAX)
   (Call IoString)
   (MovRR EAX ESI)
   (XorRR EDX EDX)
   (Jmp32 AllocObj)

   (PrimitiveEntry PrFileOpen)
   (MovRM ESI EAX)
   (MovRMD EAX EAX 04)
   (MovRM EBX EAX)
   (SarI8 EBX 02)
   (PushR EBX)
   (MovRMD EAX EAX 04)
   (MovRM EDX EAX)
   (SarI8 EDX 02)
   (PushR EDX)
   (MovRR EAX ESI)
   (Call IoString)
   ; ESI bytes, ECX length. Allocate a NUL-terminated, non-scanned copy.
   (IncR ECX)
   (Call AllocAtomic)
   (MovRR EBX EDI)
   (DecR ECX)
   (RepMovsb)
   (PopR EDX)
   (PopR ECX)
   (MovRI EAX (Small 5))
   (Int 80)
   (Jmp32 IoResult)

   (PrimitiveEntry PrFileClose)
   (MovRM EBX EAX)
   (SarI8 EBX 02)
   (MovRI EAX (Small 6))
   (Int 80)
   (Jmp32 IoResult)

   (PrimitiveEntry PrFileRead)
   (Call IoBufferArgs)
   (MovRI EAX (Small 3))
   (Int 80)
   (Jmp32 IoResult)
   (PrimitiveEntry PrFileWrite)
   (Call IoBufferArgs)
   (MovRI EAX (Small 4))
   (Int 80)
   (Jmp32 IoResult)

   (PrimitiveEntry PrFileSeek)
   (MovRM EBX EAX)
   (SarI8 EBX 02)
   (MovRMD EAX EAX 04)
   (MovRM ECX EAX)
   (SarI8 ECX 02)
   (MovRMD EAX EAX 04)
   (MovRM EDX EAX)
   (SarI8 EDX 02)
   (MovRI EAX (X8 0 0 0 0 0 0 1 3))
   (Int 80)
   ; Offsets outside the fixnum range cannot be represented yet.
   (CmpI32 EAX (X8 1 F F F F F F F))
   (Jle IoResult)
   (MovRI EAX (X8 F F F F F F B 5)) ; -EOVERFLOW
   (Label IoResult)
   (ShlI8 EAX 02)
   (OrI8 EAX 01)
   (Ret)

   ; Checked string -> ESI raw bytes, ECX length. Clobbers EAX/EDX.
   (Label IoString)
   (MovRR EDX EAX)
   (AndI8 EDX 03)
   (CmpI8 EDX 02)
   (Jnz32 ErrApply)
   (SubI8 EAX 02)
   (MovRM ESI EAX)
   (MovRR EDX ESI)
   (AndI8 EDX 07)
   (CmpI8 EDX 01)
   (Jnz32 ErrApply)
   (AndI8 ESI F8)
   (MovRMD ECX EAX 04)
   (SarI8 ECX 02)
   (Ret)

   ; (fd string start count) -> EBX fd, ECX raw buffer, EDX count.
   ; Bounds are checked by subtraction, so start+count cannot overflow.
   (Label IoBufferArgs)
   (MovRM EBX EAX)
   (SarI8 EBX 02)
   (MovRMD EAX EAX 04)
   (MovRMD EDI EAX 04)
   (MovRM EAX EAX)
   (Call IoString)
   (MovRM EAX EDI)
   (SarI8 EAX 02)
   (CmpRR EAX ECX)
   (Ja32 ErrApply)
   (SubRR ECX EAX)
   (AddRR ESI EAX)
   (MovRMD EDI EDI 04)
   (MovRM EDX EDI)
   (SarI8 EDX 02)
   (CmpRR EDX ECX)
   (Ja32 ErrApply)
   (MovRR ECX ESI)
   (Ret)

   (PrimitiveEntry PrEofObject)
   (MovRI EAX (SchemeEOF))
   (Ret)

   ; Original argc/argv/environment remain in the immutable initial stack.
   (PrimitiveEntry PrCommandLine)
   (MovRMemL EBX GStackTop)
   (MovRM EDX EBX)
   (MovRR EAX EDX)
   (ShlI8 EAX 02)
   (AddRR EBX EAX)
   (MovRI ESI (SchemeNil))
   (Label (IoArgv Next))
   (TestRR EDX EDX)
   (Jz (IoArgv Done))
   (PushR EDX)
   (PushR ESI)
   (MovRM EAX EBX)
   (Call IoCString)
   (PopR ECX)
   (Call Cons)
   (MovRR ESI EAX)
   (PopR EDX)
   (SubI8 EBX 04)
   (DecR EDX)
   (JmpS (IoArgv Next))
   (Label (IoArgv Done))
   (MovRR EAX ESI)
   (Ret)

   (PrimitiveEntry PrGetenv)
   (MovRM EAX EAX)
   (Call IoString)
   (MovRMemL EBX GStackTop)
   (MovRM EAX EBX)
   (ShlI8 EAX 02)
   (AddRR EBX EAX)
   (AddI8 EBX 08)
   (Label (IoEnv Next))
   (MovRM EDI EBX)
   (TestRR EDI EDI)
   (Jz (IoEnv Missing))
   (PushR ESI)
   (PushR ECX)
   (Label (IoEnv Compare))
   (TestRR ECX ECX)
   (Jz (IoEnv Equals))
   (MovzxRMb EAX ESI)
   (MovzxRMb EDX EDI)
   (CmpRR EAX EDX)
   (Jnz (IoEnv Skip))
   (IncR ESI)
   (IncR EDI)
   (DecR ECX)
   (JmpS (IoEnv Compare))
   (Label (IoEnv Equals))
   (MovzxRMb EAX EDI)
   (CmpI8 EAX 3D)
   (Jnz (IoEnv Skip))
   (PopR ECX)
   (PopR ESI)
   (MovRR EAX EDI)
   (IncR EAX)
   (Jmp32 IoCString)
   (Label (IoEnv Skip))
   (PopR ECX)
   (PopR ESI)
   (AddI8 EBX 04)
   (JmpS (IoEnv Next))
   (Label (IoEnv Missing))
   (MovRI EAX (SchemeFalse))
   (Ret)

   ; Copy a NUL-terminated OS string into managed storage; preserve EBX.
   (Label IoCString)
   (PushR EBX)
   (MovRR EBX EAX)
   (XorRR ECX ECX)
   (Label (IoCString Next))
   (MovzxRMb EDX EBX)
   (TestRR EDX EDX)
   (Jz (IoCString Done))
   (IncR EBX)
   (IncR ECX)
   (JmpS (IoCString Next))
   (Label (IoCString Done))
   (MovRI EDX (Small 1))
   (Call AllocObj)
   (PopR EBX)
   (Ret)))
