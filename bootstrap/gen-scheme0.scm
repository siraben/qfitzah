  (I "(Jb (RE 8))")
  (I "(CmpALI8 39)")
  (I "(Ja (RE 8))")
  (I "(PopR EAX)")
  (call "ReadCh")
  (MOVRI "ECX" (k 1))
  (I "(Jmp32 ReadNum)")
