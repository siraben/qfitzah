  (I "(CmpALI8 27)")
  (I "(Jnz (RE 4))")
  (call "ReadExpr")
  (MOVRI "ECX" (k NIL))
  (call "Cons")
  (I "(MovRR ECX EAX)")
  (I "(MovRMemL EAX GSymQuote)")
  (I "(Jmp32 Cons)")
  (L "(RE 4)")
  (I "(CmpALI8 23)")
