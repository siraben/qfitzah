; ---------------------------------------------------------------------------
; Emission.
; ---------------------------------------------------------------------------
(define (repeat-str s n) (if (= n 0) "" (string-append s (repeat-str s (- n 1)))))
(define (take-n lst n) (if (or (= n 0) (null? lst)) '() (cons (car lst) (take-n (cdr lst) (- n 1)))))
(define (drop-n lst n) (if (or (= n 0) (null? lst)) lst (drop-n (cdr lst) (- n 1))))
(define (pl s) (begin (display s) (newline)))

(define (emit-blocks items bi)
  (if (null? items)
      #t
      (let ((blk (take-n items 24))
            (rest (drop-n items 24)))
        (begin
          (pl (string-append "(Rule (Z " (number->string bi) ")"))
          (for-each (lambda (ins) (pl (string-append "  (Ins " ins))) blk)
          (if (null? rest)
              (pl (string-append "  End" (repeat-str ")" (length blk)) ")"))
              (pl (string-append "  (Z " (number->string (+ bi 1)) ")"
                    (repeat-str ")" (length blk)) ")")))
          (emit-blocks rest (+ bi 1))))))

(define (main)
  (begin
    (build)
    (let ((s (reverse s-rev)))
      (begin
        (pl "; scheme0: Stage 2 minimal Scheme interpreter (reader/printer).")
        (pl "; GENERATED by tools/build_scheme0.py -- edit the builder, then")
        (pl "; regenerate. The builder is a formatter: instructions appear")
        (pl "; there 1:1, in order.")
        (emit-blocks s 0)
        (pl "")
        (pl (string-append "(Assemble (Program Start "
              (x8-str (w32-shl (k 1) 28)) " (Z 0)))"))))))

(main)
