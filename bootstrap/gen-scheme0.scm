  (L "(SW 4)")
  (I "(Ret)")

  ; --- Reader ---
  (L "ReadExpr")
  (call "SkipWS")
  (call "ReadCh")
  (CMPEAX wm1)
  (I "(Jnz (RE 1))")
  (MOVRI "EAX" (k EOFV))
  (I "(Ret)")
  (L "(RE 1)")
  (I "(CmpALI8 28)")
  (I "(Jnz (RE 2))")
  (I "(Jmp32 ReadList)")
