; Assembly macros for scheme0, sc1 and rsc.
; Load after qfasm.qf1, before scheme0.qfasm or either runtime file.
; These are rewrite programs, not native seed primitives or generated output.

; Flat blocks preserve instruction order. Splice explicitly expands a group;
; a plain element is always exactly one instruction. Continuations stay Ins/End.
(Block (instruction . more) rest) (Ins instruction (Block more rest))
(Block ((Splice code) . more) rest) (Block code (Block more rest))
(Block () rest) rest
(ListCons x xs) (x . xs)
(ListAppend (x . xs) ys) (ListCons x (ListAppend xs ys))
(ListAppend () ys) ys
(ListLength (x . xs)) (Add32 (Small 1) (ListLength xs))
(ListLength ()) (Small 0)

; Word representation shared by the interpreter and compiled runtimes.
; Pair=00, fixnum=01, object=10, immediate=11 in the low two bits.
; Object subtypes: symbol=0, string=1, closure=2, primitive=3, vector=4.
; A character is (ASCII << 8) | 53; integer values are shifted left by two.
(SchemeNil) (Small 3)
(SchemeTrue) (X8 0 0 0 0 0 0 1 3)
(SchemeFalse) (X8 0 0 0 0 0 0 2 3)
(SchemeEOF) (X8 0 0 0 0 0 0 3 3)
(SchemeUnspecified) (X8 0 0 0 0 0 0 4 3)

; Spelling tokens are uppercase letters denoting LOWERCASE ASCII, plus the
; punctuation below. No atom introspection is assumed. One spelling drives
; both Intern's length and the emitted bytes (no terminator or alignment).
(LowerAscii A) 61
(LowerAscii B) 62
(LowerAscii C) 63
(LowerAscii D) 64
(LowerAscii E) 65
(LowerAscii F) 66
(LowerAscii G) 67
(LowerAscii H) 68
(LowerAscii I) 69
(LowerAscii J) 6A
(LowerAscii K) 6B
(LowerAscii L) 6C
(LowerAscii M) 6D
(LowerAscii N) 6E
(LowerAscii O) 6F
(LowerAscii P) 70
(LowerAscii Q) 71
(LowerAscii R) 72
(LowerAscii S) 73
(LowerAscii T) 74
(LowerAscii U) 75
(LowerAscii V) 76
(LowerAscii W) 77
(LowerAscii X) 78
(LowerAscii Y) 79
(LowerAscii Z) 7A
(LowerAscii /) 2F
(LowerAscii %) 25
(LowerAscii !) 21
(LowerAscii ?) 3F
(LowerAscii +) 2B
(LowerAscii -) 2D
(LowerAscii *) 2A
(LowerAscii =) 3D
(LowerAscii <) 3C
(LowerAscii >) 3E
(AsciiData ()) ()
(AsciiData (ch . chars)) (ListCons (Db (LowerAscii ch)) (AsciiData chars))

; Order is part of the binary layout. eq?/eqv? have distinct cells but share
; code. rsc inserts its extra primitives before error/exit, not after them.
(Rule (CommonPrimitives)
  ((Prim cons PrCons (C O N S))
   (Prim car PrCar (C A R))
   (Prim cdr PrCdr (C D R))
   (Prim set-car! PrSetCar (S E T - C A R !))
   (Prim set-cdr! PrSetCdr (S E T - C D R !))
   (Prim pair? PrPairQ (P A I R ?))
   (Prim null? PrNullQ (N U L L ?))
   (Prim eq? PrEqQ (E Q ?))
   (Prim eqv? PrEqQ (E Q V ?))
   (Prim symbol? PrSymQ (S Y M B O L ?))
   (Prim number? PrNumQ (N U M B E R ?))
   (Prim string? PrStrQ (S T R I N G ?))
   (Prim char? PrCharQ (C H A R ?))
   (Prim procedure? PrProcQ (P R O C E D U R E ?))
   (Prim boolean? PrBoolQ (B O O L E A N ?))
   (Prim not PrNot (N O T))
   (Prim + PrAdd (+))
   (Prim - PrSub (-))
   (Prim * PrMul (*))
   (Prim quotient PrQuot (Q U O T I E N T))
   (Prim remainder PrRem (R E M A I N D E R))
   (Prim = PrNumEq (=))
   (Prim < PrLt (<))
   (Prim > PrGt (>))
   (Prim <= PrLe (< =))
   (Prim >= PrGe (> =))
   (Prim display PrDisplay (D I S P L A Y))
   (Prim write PrWrite (W R I T E))
   (Prim newline PrNewline (N E W L I N E))
   (Prim read-char PrReadChar (R E A D - C H A R))
   (Prim peek-char PrPeekChar (P E E K - C H A R))
   (Prim eof-object? PrEofQ (E O F - O B J E C T ?))
   (Prim char->integer PrCharInt (C H A R - > I N T E G E R))
   (Prim integer->char PrIntChar (I N T E G E R - > C H A R))
   (Prim string-length PrStrLen (S T R I N G - L E N G T H))
   (Prim string-ref PrStrRef (S T R I N G - R E F))
   (Prim string->symbol PrStrSym (S T R I N G - > S Y M B O L))
   (Prim symbol->string PrSymStr (S Y M B O L - > S T R I N G))
   (Prim list->string PrListStr (L I S T - > S T R I N G))))
(ProcessPrimitives) ((Prim error PrError (E R R O R)) (Prim exit PrExit (E X I T)))
(CorePrimitives) (ListAppend (CommonPrimitives) (ProcessPrimitives))
(Rule (ExtraPrimitives)
  ((Prim make-string PrMakeStr (M A K E - S T R I N G))
   (Prim string-set! PrStrSet (S T R I N G - S E T !))
   (Prim apply PrApply (A P P L Y))
   (Prim make-vector PrMakeVec (M A K E - V E C T O R))
   (Prim vector PrVector (V E C T O R))
   (Prim vector-ref PrVecRef (V E C T O R - R E F))
   (Prim vector-set! PrVecSet (V E C T O R - S E T !))
   (Prim vector-length PrVecLen (V E C T O R - L E N G T H))
   (Prim vector? PrVecQ (V E C T O R ?))
   (Prim vector->list PrVecList (V E C T O R - > L I S T))
   (Prim list->vector PrListVec (L I S T - > V E C T O R))
   (Prim gc PrGc (G C))
   (Prim gc-count PrGcCount (G C - C O U N T))
   (Prim %gc-live-units PrGcLiveUnits (% G C - L I V E - U N I T S))
   (Prim %gc-largest-free-units PrGcLargestFreeUnits (% G C - L A R G E S T - F R E E - U N I T S))
   (Prim make-symbol PrMakeSym (M A K E - S Y M B O L))
   (Prim %identity-hash PrIdentityHash (% I D E N T I T Y - H A S H))
   (Prim %env-find PrEnvFind (% E N V - F I N D))
   (Prim %assq PrAssocQ (% A S S Q))
   (Prim %memq PrMemberQ (% M E M Q))
   (Prim %file-open PrFileOpen (% F I L E - O P E N))
   (Prim %file-close PrFileClose (% F I L E - C L O S E))
   (Prim %file-read PrFileRead (% F I L E - R E A D))
   (Prim %file-write PrFileWrite (% F I L E - W R I T E))
   (Prim %file-seek PrFileSeek (% F I L E - S E E K))
   (Prim %eof-object PrEofObject (% E O F - O B J E C T))
   (Prim command-line PrCommandLine (C O M M A N D - L I N E))
   (Prim getenv PrGetenv (G E T E N V))
   (Prim call/cc PrCallCC (C A L L / C C))
   (Prim call-with-current-continuation PrCallCC
         (C A L L - W I T H - C U R R E N T - C O N T I N U A T I O N))))
(RscPrimitives) (ListAppend (CommonPrimitives) (ListAppend (ExtraPrimitives) (ProcessPrimitives)))

(ForPrimitives mode primitives) (Splice (PrimitiveList mode primitives))
(PrimitiveList mode ()) ()
(PrimitiveList mode ((Prim name code chars) . more)) (ListCons (PrimitiveAction mode name code chars) (PrimitiveList mode more))
; Compiled callable: subtype-2 payload (code . nil), stored in a global cell.
(Rule (PrimitiveAction Compiled name code chars)
  (Splice ((MovRILabel EAX code) (MovRI ECX (SchemeNil)) (Call Cons)
           (OrI8 EAX 02) (MovRI ECX (Small 1)) (Call Cons)
           (OrI8 EAX 02) (MovMemLR (GV name) EAX)
           (MovMemLR (GP name) EAX))))
; scheme0 instead interns the spelling and installs a subtype-3 primitive.
(Rule (PrimitiveAction Interpreted name code chars)
  (Splice ((MovRILabel EAX (PN name)) (MovRI ECX (ListLength chars))
           (Call Intern) (MovRILabel ECX code) (Call DefPrim))))
; GP is immutable after startup and remains a GC root alongside the mutable GV.
(Rule (PrimitiveAction Globals name code chars)
  (Splice ((Label (GV name)) (Dd (Small 0)) (Label (GP name)) (Dd (Small 0)))))
(PrimitiveAction Names name code chars) (Splice ((Label (PN name)) (Splice (AsciiData chars))))

; Special forms: one declaration drives startup, dispatch, cells and spellings.
; else is interned but is not an evaluator dispatch case.
(Rule (SpecialForms)
  ((Special GSymQuote LQuote (Q U O T E) ((MovRMD EAX EAX 04) (MovRM EAX EAX) (Ret)))
   (Special GSymIf LIf (I F) ((Jmp32 EvIf)))
   (Special GSymDefine LDefine (D E F I N E) ((Jmp32 EvDefine)))
   (Special GSymSet LSet (S E T !) ((Jmp32 EvSet)))
   (Special GSymLambda LLambda (L A M B D A) ((Jmp32 EvLambda)))
   (Special GSymBegin LBegin (B E G I N) ((Jmp32 EvBegin)))
   (Special GSymLet LLet (L E T) ((Jmp32 EvLet)))
   (Special GSymCond LCond (C O N D) ((Jmp32 EvCond)))
   (Special GSymAnd LAnd (A N D) ((Jmp32 EvAnd)))
   (Special GSymOr LOr (O R) ((Jmp32 EvOr)))
   (Special GSymElse LElse (E L S E) None)))
(ForSpecials mode specials) (Splice (SpecialList mode specials))
(SpecialList mode ()) ()
(SpecialList mode ((Special global label chars action) . more)) (ListCons (SpecialAction mode global label chars action) (SpecialList mode more))
(Rule (SpecialAction Init global label chars action)
  (Splice ((MovRILabel EAX label) (MovRI ECX (ListLength chars))
           (Call Intern) (MovMemLR global EAX))))
(SpecialAction Globals global label chars action) (Splice ((Label global) (Dd (Small 0))))
(SpecialAction Names global label chars action) (Splice ((Label label) (Splice (AsciiData chars))))
(Rule (SpecialAction Dispatch global label chars action)
  (Splice ((MovRMemL EBX global) (CmpRR EDX EBX) (Jnz (EV 5 global))
           (Splice action) (Label (EV 5 global)))))
(SpecialAction Dispatch global label chars None) (Splice ())

; Align entries for tagged code addresses.
(PrimitiveEntry label) (Splice ((Align8) (Label label)))
(Rule (ReturnBoolean prefix)
  (Splice ((Label (prefix T)) (MovRI EAX (SchemeTrue)) (Ret)
           (Label (prefix F)) (MovRI EAX (SchemeFalse)) (Ret))))
; TODO: compare all operands, not just the first two.
(Rule (ComparePrimitive label prefix branch)
  (Splice ((PrimitiveEntry label) (MovRM ECX EAX) (MovRMD EAX EAX 04)
           (MovRM EAX EAX) (CmpRR ECX EAX) (branch (prefix T))
           (JmpS (prefix F)) (ReturnBoolean prefix))))

; Object-tagged relocations share the same descriptor machinery.
(Describe (DObj label)) (Encoding ((W (Tagged label (Small 2)))))
(Describe (MovRIObj reg label)) (Encoding ((B (MovIB reg)) (W (Tagged label (Small 2)))))
