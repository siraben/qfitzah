(define (bytes n)
  (let ((s (make-string n)))
    (let loop ((i 0))
      (if (= i n) s
          (begin (string-set! s i (integer->char (remainder i 256)))
                 (loop (+ i 1)))))))
(define content (bytes 12345))
(call-with-output-file "roundtrip.bin" (lambda (p) (display content p)))
(define input (open-input-file "roundtrip.bin"))
(assert (eq? (peek-char input) (integer->char 0)))
(assert (eq? (peek-char input) (integer->char 0)))
(let loop ((i 0))
