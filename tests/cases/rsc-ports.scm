; Test offset/count handling and lseek directly, without buffered input.
(define fd (%file-open "roundtrip.bin" 0 0))
(assert (>= fd 0))
(assert (= (%file-seek fd 255 0) 255))
(define buf (make-string 5 #\x))
(assert (= (%file-read fd buf 1 2) 2))
(assert (eq? (string-ref buf 0) #\x))
(assert (= (char->integer (string-ref buf 1)) 255))
(assert (= (char->integer (string-ref buf 2)) 0))
(assert (eq? (string-ref buf 3) #\x))
(assert (= (%file-close fd) 0))
(assert (< (%file-open "missing/absent" 0 0) 0))
(display "file syscall checks ok") (newline)
